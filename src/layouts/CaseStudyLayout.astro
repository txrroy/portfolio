---
import Layout from "@theme/Layout.astro";
import Header from "@theme/Header.astro";

interface Props {
  title?: string;
  description?: string;
  backUrl?: string;
  backLabel?: string;
  breadcrumbs?: string[];
  nextUrl?: string;
  nextLabel?: string;
}

const {
  title = "Case Study • Tushar Roy",
  description,
  backUrl = "/",
  backLabel = "Selected Works",
  breadcrumbs = ["Apple InfoSec", "Vanguard 3.1", "Lead Product Designer"],
} = Astro.props;

// Determine next case study URL and label automatically
const currentPath = Astro.url.pathname.replace(/\/$/, "");
let defaultNextUrl = "/case-study/helpnow";
let defaultNextLabel = "HelpNow+";

if (currentPath.includes("helpnow")) {
  defaultNextUrl = "/case-study/devhub";
  defaultNextLabel = "DevHub";
} else if (currentPath.includes("devhub")) {
  defaultNextUrl = "/case-study/vlp";
  defaultNextLabel = "VLP";
} else if (currentPath.includes("vlp")) {
  defaultNextUrl = "/case-study/vanguard";
  defaultNextLabel = "Project Vanguard";
} else {
  defaultNextUrl = "/case-study/helpnow";
  defaultNextLabel = "HelpNow+";
}

const resolvedNextUrl = Astro.props.nextUrl || defaultNextUrl;
const resolvedNextLabel = Astro.props.nextLabel || defaultNextLabel;
---

<Layout title={title} description={description}>
  <!-- Synchronous pre-render check to prevent flash if already unlocked -->
  <script is:inline>
    if (sessionStorage.getItem("portfolio_cs_unlocked") === "true") {
      document.documentElement.classList.add("cs-unlocked");
    }
  </script>

  <div class="min-h-screen bg-canvas text-primary antialiased selection:bg-black selection:text-white relative">
    <Header
      backUrl={backUrl}
      backLabel={backLabel}
      breadcrumbs={breadcrumbs}
      isCaseStudy={true}
      nextUrl={resolvedNextUrl}
      nextLabel={resolvedNextLabel}
    />
    <div id="case-study-content" class="transition-all duration-300">
      <main class="max-w-6xl mx-auto px-6 sm:px-8 pt-12 md:pt-16 pb-28">
        <slot />
      </main>
    </div>
  </div>

  <!-- Password Protection Gate Modal -->
  <div
    id="password-gate"
    class="fixed inset-0 z-50 flex items-center justify-center bg-[var(--color-canvas,#faf7f2)]/85 backdrop-blur-md px-4 py-8 sm:px-6 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Password Protected Case Study"
  >
    <div class="relative max-w-sm sm:max-w-md w-full bg-[#faf7f2] border border-black/10 rounded-3xl p-6 sm:p-7 shadow-[0_20px_50px_rgba(0,0,0,0.12)] text-center overflow-hidden transition-all duration-300">
      
      <!-- Rex Playing Visual Frame -->
      <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden mb-5 border border-black/10 shadow-sm bg-neutral-100 group">
        <img
          src="/images/rex_playing.jpg"
          alt="Rex the golden retriever happily guarding the case study with a ball"
          class="w-full h-full object-cover object-[center_60%] transition-transform duration-700 ease-out group-hover:scale-105"
        />
        <!-- Playful status pill on Rex -->
        <div class="absolute bottom-2.5 left-2.5 right-auto px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[11px] font-mono text-white/95 flex items-center gap-1.5 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="rex-status-tag" class="tracking-wide">REX // CHIEF MORALE OFFICER 🐾</span>
        </div>
      </div>

      <!-- Title -->
      <h3 class="text-2xl font-bold tracking-tight text-[var(--color-text-primary)] mb-5 font-departure">
        Password, please!
      </h3>

      <!-- Minimal Playful Password Capsule Form -->
      <form id="password-form" class="space-y-3 w-full max-w-sm mx-auto">
        <div
          id="password-input-container"
          class="relative flex items-center bg-white border border-black/20 rounded-full pl-4 pr-1.5 py-1.5 shadow-sm transition-all duration-200 focus-within:border-black focus-within:ring-2 focus-within:ring-black/10"
        >
          <svg class="w-4 h-4 text-neutral-400 shrink-0 mr-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <input
            id="password-input"
            type="password"
            placeholder="Enter password..."
            autocomplete="current-password"
            class="w-full bg-transparent text-sm font-mono text-[var(--color-text-primary)] placeholder:text-black/35 outline-none"
            required
          />
          <button
            id="password-submit-btn"
            type="submit"
            class="w-8 h-8 rounded-full bg-neutral-900 text-white hover:bg-black active:scale-90 flex items-center justify-center transition-all shrink-0 cursor-pointer shadow-sm group"
            aria-label="Unlock Case Study"
            title="Unlock"
          >
            <svg id="password-btn-arrow" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            <svg id="password-btn-check" class="w-4 h-4 hidden text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>

        <!-- Playful Feedback Message -->
        <p id="password-error" class="hidden text-xs text-red-600 font-mono text-center transition-all">
          🐾 Rex tilted his head... wrong password! Try again.
        </p>
      </form>

      <!-- Simple Playful Footer -->
      <div class="mt-5 pt-3.5 border-t border-black/10 flex items-center justify-between text-xs font-mono text-[var(--color-text-secondary)]">
        <a href="/" class="hover:text-black transition-colors flex items-center gap-1">
          <span>←</span>
          <span>Back to works</span>
        </a>
        <a
          href="mailto:contact@tusharroy.com?subject=Case%20Study%20Password%20Request"
          class="hover:text-black transition-colors underline underline-offset-2"
        >
          Need access?
        </a>
      </div>
    </div>
  </div>

  <!-- Image Zoom Lightbox Overlay with Gallery Navigation -->
  <div
    id="image-zoom-overlay"
    class="fixed inset-0 bg-black/95 z-50 hidden opacity-0 transition-opacity duration-300 flex flex-col items-center justify-between p-4 sm:p-6 select-none cursor-zoom-out"
    role="dialog"
    aria-modal="true"
    aria-label="Image Preview Gallery"
  >
    <!-- Top Bar with Title, Counter, and Close Button -->
    <div
      class="w-full max-w-6xl flex items-center justify-between text-white font-mono text-xs mb-3 px-2 z-20 cursor-default"
    >
      <div class="flex items-center gap-3 truncate max-w-lg">
        <span id="zoom-title" class="truncate text-white/90 font-sans text-sm">
          Visual Inspection
        </span>
        <span id="zoom-counter" class="text-white/50 text-xs shrink-0 font-mono">
          1 / 1
        </span>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="image-zoom-close"
          class="px-3 py-1 bg-white/10 hover:bg-white/20 border border-white/30 text-white rounded-full transition-colors flex items-center gap-1.5 cursor-pointer text-xs"
        >
          <span>Close</span>
          <kbd
            class="text-[10px] bg-white/20 border-white/40 text-white px-1 shadow-none rounded"
          >ESC</kbd>
        </button>
      </div>
    </div>

    <!-- Center Viewport with Floating Left / Right Navigation Arrows -->
    <div
      class="relative max-w-6xl max-h-[82vh] w-full flex-1 flex items-center justify-center overflow-hidden my-auto cursor-zoom-out"
    >
      <!-- Previous Arrow Button -->
      <button
        id="image-zoom-prev"
        type="button"
        class="absolute left-2 sm:left-4 z-30 w-11 h-11 rounded-full bg-black/60 hover:bg-black/90 text-white/80 hover:text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all cursor-pointer active:scale-95 group shadow-lg"
        title="Previous Image (Left Arrow)"
        aria-label="Previous Image"
      >
        <svg
          class="w-5 h-5 transition-transform group-hover:-translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <!-- Full-size Image Display -->
      <img
        id="image-zoom-img"
        src=""
        alt="Full size view"
        class="max-w-full max-h-[80vh] object-contain shadow-2xl rounded-lg border border-white/15 transition-opacity duration-200 cursor-default"
      />

      <!-- Next Arrow Button -->
      <button
        id="image-zoom-next"
        type="button"
        class="absolute right-2 sm:right-4 z-30 w-11 h-11 rounded-full bg-black/60 hover:bg-black/90 text-white/80 hover:text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all cursor-pointer active:scale-95 group shadow-lg"
        title="Next Image (Right Arrow)"
        aria-label="Next Image"
      >
        <svg
          class="w-5 h-5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>

    <!-- Bottom Hint Bar -->
    <div class="text-white/40 font-mono text-[11px] pt-2 flex items-center gap-4 z-20">
      <span>Use <kbd class="px-1 bg-white/10 rounded">←</kbd> <kbd class="px-1 bg-white/10 rounded">→</kbd> to navigate</span>
      <span>•</span>
      <span><kbd class="px-1 bg-white/10 rounded">ESC</kbd> to close</span>
    </div>
  </div>

  <script>
    const overlay = document.getElementById("image-zoom-overlay");
    const zoomImg = document.getElementById("image-zoom-img") as HTMLImageElement | null;
    const zoomTitle = document.getElementById("zoom-title");
    const zoomCounter = document.getElementById("zoom-counter");
    const closeBtn = document.getElementById("image-zoom-close");
    const prevBtn = document.getElementById("image-zoom-prev");
    const nextBtn = document.getElementById("image-zoom-next");
    let isZoomOpen = false;
    let currentIndex = 0;
    let imagesList: HTMLImageElement[] = [];

    function updateZoomView(index: number) {
      if (!imagesList.length || !zoomImg) return;
      // Seamless circular wrap
      currentIndex = (index + imagesList.length) % imagesList.length;
      const targetImg = imagesList[currentIndex];

      zoomImg.style.opacity = "0.7";
      zoomImg.src = targetImg.src;
      zoomImg.alt = targetImg.alt || "Case Study Visual";

      if (zoomTitle) {
        zoomTitle.textContent = targetImg.alt || "Visual Inspection";
      }
      if (zoomCounter) {
        zoomCounter.textContent = `${currentIndex + 1} / ${imagesList.length}`;
      }
      requestAnimationFrame(() => {
        if (zoomImg) zoomImg.style.opacity = "1";
      });
    }

    function openZoom(index: number) {
      if (!overlay || !zoomImg) return;
      updateZoomView(index);
      overlay.classList.remove("hidden");
      requestAnimationFrame(() => {
        overlay.classList.remove("opacity-0");
      });
      document.body.style.overflow = "hidden";
      isZoomOpen = true;
    }

    function closeZoom() {
      if (!overlay) return;
      overlay.classList.add("opacity-0");
      setTimeout(() => {
        overlay.classList.add("hidden");
        if (zoomImg) zoomImg.src = "";
      }, 300);
      document.body.style.overflow = "";
      isZoomOpen = false;
    }

    function initImageZoom() {
      imagesList = Array.from(document.querySelectorAll("main img")) as HTMLImageElement[];
      imagesList.forEach((img, idx) => {
        img.style.cursor = "zoom-in";
        img.addEventListener("click", () => {
          openZoom(idx);
        });
      });
    }

    initImageZoom();

    // Navigation Click listeners
    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      updateZoomView(currentIndex - 1);
    });

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      updateZoomView(currentIndex + 1);
    });

    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeZoom();
    });

    overlay?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Do not close if clicking directly on the image itself
      if (target === zoomImg || zoomImg?.contains(target)) {
        return;
      }

      // Do not close if clicking navigation arrows
      if (prevBtn?.contains(target) || nextBtn?.contains(target)) {
        return;
      }

      // Any click on a blank area (overlay background, viewport container, top/bottom bars) closes the overlay
      closeZoom();
    });

    // Keyboard navigation: ArrowLeft, ArrowRight, Escape
    document.addEventListener("keydown", (e) => {
      if (!isZoomOpen) return;
      if (e.key === "Escape") {
        closeZoom();
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        updateZoomView(currentIndex - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        updateZoomView(currentIndex + 1);
      }
    });

    // -----------------------------------------------------------------
    // Section Kicker Typewriter Effect
    // -----------------------------------------------------------------
    function setupKickers() {
      const allKickers = document.querySelectorAll<HTMLElement>(".kicker");
      if (!allKickers.length) return;

      // In case of mobile, kickers remain static with no animation
      const isMobile =
        window.innerWidth < 768 ||
        window.matchMedia("(max-width: 767px)").matches;
      if (
        isMobile ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        allKickers.forEach((kicker) => {
          const raw =
            kicker.getAttribute("data-text") ||
            kicker.textContent?.trim() ||
            "";
          if (raw) kicker.textContent = raw;
          kicker.style.opacity = "1";
        });
        return;
      }

      // Initialize eligible kickers (exclude role, team, and outcome)
      allKickers.forEach((kicker) => {
        const text = kicker.textContent?.trim().toLowerCase() || "";
        const isHeroMetadata = kicker.closest(".grid") !== null;
        const isExcluded =
          isHeroMetadata ||
          text === "role" ||
          text === "team" ||
          text === "outcome";

        if (isExcluded) return; // Keep static and visible

        if (!kicker.hasAttribute("data-text")) {
          const raw = kicker.textContent?.trim() || "";
          kicker.setAttribute("data-text", raw);
          kicker.textContent = "";
          kicker.style.opacity = "0";
        }
      });

      function typewrite(el: HTMLElement) {
        if (el.dataset.typed === "true") return;
        el.dataset.typed = "true";

        const text = el.getAttribute("data-text") || "";
        if (!text) return;

        el.style.opacity = "1";
        let i = 0;
        const charDelay = 75; // Slower, relaxed typing speed

        function typeNext() {
          if (i < text.length) {
            el.textContent = text.slice(0, i + 1);
            i++;
            setTimeout(typeNext, charDelay + (Math.random() * 16 - 8));
          }
        }
        typeNext();
      }

      // Trigger only when kicker reaches about 1/3 of the screen from the bottom
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              typewrite(el);
              observer.unobserve(el);
            }
          });
        },
        {
          rootMargin: "0px 0px -33% 0px",
          threshold: 0.1,
        }
      );

      allKickers.forEach((kicker) => {
        if (kicker.hasAttribute("data-text")) {
          observer.observe(kicker);
        }
      });

      // Handle window resize dynamically
      window.addEventListener(
        "resize",
        () => {
          if (window.innerWidth < 768) {
            allKickers.forEach((kicker) => {
              const raw =
                kicker.getAttribute("data-text") ||
                kicker.textContent?.trim() ||
                "";
              if (raw) kicker.textContent = raw;
              kicker.style.opacity = "1";
            });
          }
        },
        { passive: true }
      );
    }

    // Password protection gate script
    function setupPasswordGate() {
      const form = document.getElementById("password-form") as HTMLFormElement | null;
      const input = document.getElementById("password-input") as HTMLInputElement | null;
      const inputContainer = document.getElementById("password-input-container");
      const errorMsg = document.getElementById("password-error");
      const gate = document.getElementById("password-gate");
      const statusTag = document.getElementById("rex-status-tag");
      const arrowIcon = document.getElementById("password-btn-arrow");
      const checkIcon = document.getElementById("password-btn-check");

      if (!form || !input) return;

      if (sessionStorage.getItem("portfolio_cs_unlocked") === "true") {
        document.documentElement.classList.add("cs-unlocked");
        return;
      }

      // Auto-focus input on load
      setTimeout(() => {
        input.focus();
      }, 150);

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const val = input.value.trim().toLowerCase();

        // Accept "ux" (official password) or "rex" as a playful easter egg
        if (val === "ux" || val === "rex") {
          sessionStorage.setItem("portfolio_cs_unlocked", "true");
          document.documentElement.classList.add("cs-unlocked");

          if (statusTag) {
            statusTag.textContent = "REX APPROVED! UNLOCKING... 🐾";
          }
          if (arrowIcon && checkIcon) {
            arrowIcon.classList.add("hidden");
            checkIcon.classList.remove("hidden");
          }
          if (errorMsg) errorMsg.classList.add("hidden");

          if (gate) {
            gate.classList.add("opacity-0", "scale-95");
            setTimeout(() => {
              gate.style.display = "none";
            }, 300);
          }
        } else {
          if (errorMsg) errorMsg.classList.remove("hidden");
          if (statusTag) {
            statusTag.textContent = "WOOF! TRY AGAIN 🎾";
            setTimeout(() => {
              if (statusTag && !document.documentElement.classList.contains("cs-unlocked")) {
                statusTag.textContent = "REX // CHIEF MORALE OFFICER 🐾";
              }
            }, 2000);
          }
          if (inputContainer) {
            inputContainer.classList.add("!border-red-500", "animate-shake");
            setTimeout(() => {
              inputContainer.classList.remove("animate-shake");
            }, 450);
          }
          input.select();
        }
      });
    }

    function initPage() {
      setupKickers();
      setupPasswordGate();
    }

    // Run on load and on astro page swaps
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPage);
    } else {
      initPage();
    }
    document.addEventListener("astro:page-load", initPage);
  </script>

  <style is:global>
    /* Password Gate Styles */
    html.cs-unlocked #password-gate {
      display: none !important;
    }
    html.cs-unlocked #case-study-content {
      filter: none !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      user-select: auto !important;
    }
    html:not(.cs-unlocked) #case-study-content {
      filter: blur(14px);
      opacity: 0.12;
      pointer-events: none;
      user-select: none;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .animate-shake {
      animation: shake 0.4s ease-in-out;
    }

    /* Clean Typewriter Effect for Case Study Kickers (No cursor) */
    .kicker {
      font-family: var(--font-handwriting, "Homemade Apple", cursive) !important;
      color: #c98c1c;
      display: inline-flex !important;
      align-items: center;
      position: relative !important;
      margin-bottom: 0.25rem;
      min-height: 1.5rem;
    }
  </style>
</Layout>
