---
import Layout from "./Layout.astro";
import Header from "./Header.astro";
---

<Layout
  title="Tushar Roy – Systematic by Design • Product Design & Design Engineering"
>
  <Header />

  <!-- ========================================================================= -->
  <!-- HERO SECTION                                                              -->
  <!-- ========================================================================= -->
  <section
    id="hero-section"
    class="relative z-10 w-full pt-32 sm:pt-40 md:pt-44 pb-20 md:pb-28 overflow-hidden"
  >
    <!-- Interactive Dot Grid Canvas Background -->
    <canvas
      id="hero-dot-grid"
      class="absolute inset-0 w-full h-full pointer-events-none z-0"
      aria-hidden="true"></canvas>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div
        class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-[70vh]"
      >
        <!-- Left Narrative Rail (7 Cols) -->
        <div
          class="lg:col-span-7 flex flex-col items-center text-center lg:items-start lg:text-left"
        >
          <!-- Eyebrow -->
          <small class="eyebrow text-center lg:text-left">
            STAFF PRODUCT DESIGNER // DESIGN ENGINEER
          </small>

          <!-- Main Display Headline -->
          <h1 class="text-center lg:text-left">
            Systematic <br class="hidden sm:block" />by Design.
          </h1>

          <!-- Lead Narrative -->
          <p class="mx-auto lg:mx-0 text-center lg:text-left">
            I build end-to-end product experiences with
            <br class="hidden sm:inline" />
            AI-ready design systems and hand-off in code.
          </p>

          <!-- CTA Action in Primary Pill -->
          <div
            class="flex flex-wrap items-center justify-center lg:justify-start gap-4"
          >
            <a href="#work" class="group btn-primary text-base px-7 py-3.5">
              <span>See what I built</span>
              <span
                class="w-6 h-6 rounded-full bg-neutral-900 text-white flex items-center justify-center text-xs transition-transform duration-200 group-hover:translate-y-0.5"
              >
                <svg
                  class="w-3.5 h-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 5v14M19 12l-7 7-7-7"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>

        <!-- Right Visual: Arch Portrait (5 Cols) -->
        <div
          class="lg:col-span-5 flex flex-col items-center justify-center relative"
        >
          <div class="relative w-full max-w-[280px] sm:max-w-[320px]">
            <div class="relative aspect-[3/4] w-full">
              <!-- Decorative Offset Border -->
              <div
                class="absolute top-4 -left-4 w-full h-full rounded-t-[220px] border border-black/10 z-0"
              >
              </div>

              <!-- Rex & Tushar Window Mask (Static Arch Frame) -->
              <div class="relative w-full h-full">
                <img
                  id="hero-portrait-img"
                  src="/images/rex.jpg"
                  alt="Tushar and Rex the golden retriever"
                  class="object-cover w-full h-full origin-center grayscale-[12%] hover:grayscale-0 transition-all duration-700 pointer-events-none rounded-t-[220px] overflow-hidden"
                  style="transform: rotate(0deg);"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SELECTED WORK / ENTERPRISE CASE STUDIES                                   -->
  <!-- ========================================================================= -->
  <main
    class="relative z-10 w-full bg-[var(--color-canvas)] border-t border-black/10 py-16 sm:py-20 lg:py-32"
  >
    <section id="work" class="max-w-6xl mx-auto px-6">
      <!-- Section Header -->
      <div
        class="w-full mb-6 sm:mb-8 lg:mb-12 flex flex-col items-center lg:items-start text-center lg:text-left"
      >
        <small class="eyebrow text-center lg:text-left"
          >WORK // CASE STUDIES</small
        >
        <h2 class="text-center lg:text-left m-0">Complexity, Made Clear.</h2>
      </div>

      <!-- Case Study Cards Stack -->
      <div class="flex flex-col gap-10 w-full">
        <!-- Case Study 01: Vanguard (Apple InfoSec) -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-20 lg:mb-12 z-10 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <div
            class="w-full lg:w-1/4 shrink-0 relative overflow-hidden h-[80px] lg:h-auto lg:min-h-full self-stretch border-b lg:border-b-0 lg:border-r border-black/10"
          >
            <img
              src="/images/case-study-vanguard-selected.png"
              alt="Vanguard Case Study"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <!-- Systems Meta Badge -->
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS 01 // SECURITY ANALYTICS • AI • HUMAN-IN-THE-LOOP
              </small>

              <!-- Main Title -->
              <h3
                class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left"
              >
                Making Security Work Measurable
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                Designed a 0→1 self-service analytics platform with automated
                AI-drafted analysis and human agency. Built a AI-ready design
                system to prototype and hand-off design using git.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Coverage</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    30% → 75%
                  </h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Onboarding</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    2 mo → 5 days
                  </h4>
                </div>
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Escalations</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    &gt;50% Cut
                  </h4>
                </div>
              </div>

              <blockquote
                class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-4 text-center lg:text-left"
              >
                "If anyone can publish, why would an executive believe
                anything?"
              </blockquote>
            </div>

            <!-- CTA with primary color from case study image -->
            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/vanguard"
                class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-105 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] no-underline"
                style="background-color: #1d4ed8;"
              >
                <svg
                  class="w-3.5 h-3.5 shrink-0 opacity-80 group-hover:opacity-100 transition-opacity"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Read Vanguard Case Study</span>
                <span
                  class="inline-block transition-transform duration-200 group-hover:translate-x-1"
                  >→</span
                >
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 02: HelpNow+ -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-24 lg:mb-8 z-20 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <div
            class="w-full lg:w-1/4 shrink-0 relative overflow-hidden h-[80px] lg:h-auto lg:min-h-full self-stretch border-b lg:border-b-0 lg:border-r border-black/10"
          >
            <img
              src="/images/case-study-helpnow-selected.png"
              alt="HelpNow+ Case Study"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS 02 // SERVICE MANAGEMENT • ITSM • DESIGN SYSTEM • BRANDING
              </small>

              <h3
                class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left"
              >
                Enterprise Support That People Could Trust
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                Led the replacement of a generic ITSM tool with a delightful
                omnichannel support platform designed to consolidate IT, HR, and
                Workplace services into a cohesive experience for 40,000+
                employees.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Savings</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    $36M+
                  </h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Escalations</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    ~40% Drop
                  </h4>
                </div>
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Positive</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    94%
                  </h4>
                </div>
              </div>

              <blockquote
                class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-4 text-center lg:text-left"
              >
                "Search made the page look simpler. Showing people their options
                made it actually simpler."
              </blockquote>
            </div>

            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/helpnow"
                class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-105 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] no-underline"
                style="background-color: #c25400;"
              >
                <svg
                  class="w-3.5 h-3.5 shrink-0 opacity-80 group-hover:opacity-100 transition-opacity"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Read HelpNow Case Study</span>
                <span
                  class="inline-block transition-transform duration-200 group-hover:translate-x-1"
                  >→</span
                >
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 03: DevHub -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-28 lg:mb-4 z-30 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <div
            class="w-full lg:w-1/4 shrink-0 relative overflow-hidden h-[80px] lg:h-auto lg:min-h-full self-stretch border-b lg:border-b-0 lg:border-r border-black/10"
          >
            <img
              src="/images/case-study-devhub-selected.png"
              alt="DevHub Case Study"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS 03 // DEVELOPER EXPERIENCE • TOOLING
              </small>

              <h3
                class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left"
              >
                Turning Fragmentation into Focus
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                20+ internal tools and no single place to start. I led the
                design of DevHub, one role-aware home for 20,000+ VMware
                engineers to find their tools, services, and docs.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Onboarding</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    80% Faster
                  </h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Scale</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    20k+ Devs
                  </h4>
                </div>
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Unified</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    20+ Tools
                  </h4>
                </div>
              </div>

              <blockquote
                class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-4 text-center lg:text-left"
              >
                "I spend more time looking for things than building things."
              </blockquote>
            </div>

            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/devhub"
                class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-105 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] no-underline"
                style="background-color: #0079b8;"
              >
                <svg
                  class="w-3.5 h-3.5 shrink-0 opacity-80 group-hover:opacity-100 transition-opacity"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Read DevHub Case Study</span>
                <span
                  class="inline-block transition-transform duration-200 group-hover:translate-x-1"
                  >→</span
                >
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 04: VLP (VMware Learning Platform) -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-32 lg:mb-0 z-40 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <div
            class="w-full lg:w-1/4 shrink-0 relative overflow-hidden h-[80px] lg:h-auto lg:min-h-full self-stretch border-b lg:border-b-0 lg:border-r border-black/10"
          >
            <img
              src="/images/case-study-vlp-selected.png"
              alt="VMware Learning Platform Case Study"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS 04 // SAAS TRANSFORMATION • DEVELOPER LABS • EDUCATION
              </small>

              <h3
                class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left"
              >
                From Internal Tool to $1M+ SaaS Product
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                A 20-year-old internal lab tool and an engineering team
                skeptical of design. This is a story of earning trust one sprint
                at a time, leading with design, and turning it into a commercial
                offering.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Revenue</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    $1M+ ARR
                  </h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Scale</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    100k+ Labs
                  </h4>
                </div>
                <div
                  class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left"
                >
                  <small class="eyebrow mb-1 text-center lg:text-left"
                    >Customers</small
                  >
                  <h4
                    class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left"
                  >
                    30+ Clients
                  </h4>
                </div>
              </div>

              <blockquote
                class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-4 text-center lg:text-left"
              >
                "I didn't ask engineers to trust design. I showed up every
                sprint with something that made their work easier."
              </blockquote>
            </div>

            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/vlp"
                class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-105 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] no-underline"
                style="background-color: #4f46e5;"
              >
                <svg
                  class="w-3.5 h-3.5 shrink-0 opacity-80 group-hover:opacity-100 transition-opacity"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Read VLP Case Study</span>
                <span
                  class="inline-block transition-transform duration-200 group-hover:translate-x-1"
                  >→</span
                >
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>

  <!-- ========================================================================= -->
  <!-- ABOUT SECTION: PURPOSE & PLAY                                             -->
  <!-- ========================================================================= -->
  <section
    id="about"
    class="relative z-10 w-full py-24 md:py-32 bg-[var(--color-canvas)] border-t border-black/10"
  >
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-12 items-center mb-12 lg:mb-8">
        <!-- Text Column -->
        <div
          class="lg:col-span-6 flex flex-col items-center text-center lg:items-start lg:text-left"
        >
          <small class="eyebrow text-center lg:text-left">ABOUT</small>

          <h2 class="text-center lg:text-left">
            Design for Clarity, <br class="hidden sm:block" />Together.
          </h2>

          <p class="mx-auto lg:mx-0 text-center lg:text-left">
            Clarity and system thinking come first for me. I started as a UX
            engineer, so I think about how something gets built as much as how
            it gets used. Now with AI tools, I build and prototype with AI-ready
            design systems - helping designers, engineers, product people, and
            agents design at the same time.
          </p>

          <p class="mx-auto lg:mx-0 text-center lg:text-left">
            At VMware, we were 8 designers in an organization of 2,000+. I
            democratized design with programs that brought the rest of the org
