---
import Layout from "./Layout.astro";
import Header from "./Header.astro";
---

<Layout title="Tushar Roy – Systematic by Design • Product & AI Systems">
  <Header />

  <!-- ========================================================================= -->
  <!-- HERO SECTION                                                              -->
  <!-- ========================================================================= -->
  <section
    id="hero-section"
    class="relative z-10 w-full pt-32 sm:pt-40 md:pt-44 pb-20 md:pb-28 overflow-hidden"
  >
    <!-- Interactive Dot Grid Canvas Background -->
    <canvas
      id="hero-dot-grid"
      class="absolute inset-0 w-full h-full pointer-events-none z-0"
      aria-hidden="true"></canvas>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div
        class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-[70vh]"
      >
        <!-- Left Narrative Rail (7 Cols) -->
        <div
          class="lg:col-span-7 flex flex-col items-center text-center lg:items-start lg:text-left"
        >
          <!-- Eyebrow -->
          <small class="eyebrow text-center lg:text-left"> PRODUCT UX // SYSTEMS ARCHITECT </small>

          <!-- Main Display Headline -->
          <h1 class="text-center lg:text-left">
            Systematic <br class="hidden sm:block" />by Design.
          </h1>

          <!-- Lead Narrative -->
          <p class="mx-auto lg:mx-0 text-center lg:text-left">
            Making sense of AI-powered enterprise systems,<br
              class="hidden sm:inline"
            />
            human&nbsp;workflows, and intelligence at scale.
          </p>

          <!-- CTA Action in Primary Pill -->
          <div
            class="flex flex-wrap items-center justify-center lg:justify-start gap-4"
          >
            <a href="#work" class="group btn-primary text-base px-7 py-3.5">
              <span>See what I built</span>
              <span
                class="w-6 h-6 rounded-full bg-neutral-900 text-white flex items-center justify-center text-xs transition-transform duration-200 group-hover:translate-y-0.5"
              >
                <svg
                  class="w-3.5 h-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 5v14M19 12l-7 7-7-7"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>

        <!-- Right Visual: Arch Portrait (5 Cols) -->
        <div
          class="lg:col-span-5 flex flex-col items-center justify-center relative"
        >
          <div class="relative w-full max-w-[280px] sm:max-w-[320px]">
            <div class="relative aspect-[3/4] w-full">
              <!-- Decorative Offset Border -->
              <div
                class="absolute top-4 -left-4 w-full h-full rounded-t-[220px] border border-black/10 z-0"
              >
              </div>

              <!-- Rex & Tushar Window Mask (Static Arch Frame) -->
              <div class="relative w-full h-full">
                <img
                  id="hero-portrait-img"
                  src="/images/rex.jpg"
                  alt="Tushar and Rex the golden retriever"
                  class="object-cover w-full h-full origin-center grayscale-[12%] hover:grayscale-0 transition-all duration-700 pointer-events-none rounded-t-[220px] overflow-hidden"
                  style="transform: rotate(0deg);"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SELECTED WORK / ENTERPRISE CASE STUDIES                                   -->
  <!-- ========================================================================= -->
  <main
    class="relative z-10 w-full bg-[var(--color-canvas)] border-t border-black/10 py-16 sm:py-20 lg:py-32"
  >
    <section id="work" class="max-w-6xl mx-auto px-6">
      <!-- Section Header -->
      <div
        class="w-full mb-6 sm:mb-8 lg:mb-12 flex flex-col items-center lg:items-start text-center lg:text-left"
      >
        <small class="eyebrow text-center lg:text-left">DESIGN CASE STUDIES</small>
        <h2 class="text-center lg:text-left m-0">Selected Works</h2>
      </div>

      <!-- Case Study Cards Stack -->
      <div class="flex flex-col gap-10 w-full">
        <!-- Case Study 01: Vanguard (Apple InfoSec) -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-20 z-10 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <a
            href="/case-study/vanguard"
            class="block w-full lg:w-1/4 shrink-0 relative overflow-hidden group/img min-h-[220px] sm:min-h-[260px] lg:min-h-full self-stretch"
            title="View Vanguard Case Study"
          >
            <img
              src="/images/case-study-vanguard-selected.png"
              alt="Vanguard Case Study"
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-105"
            />
          </a>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <!-- Systems Meta Badge -->
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS // 01 • UNDISCLOSED • PRODUCT UX
              </small>

              <!-- Main Title -->
              <h3 class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left">
                Making Security Work Measurable
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                Designed a self-service analytics platform that answered a
                fundamental question for a large organization, through automated
                metric coverage, data lineage, and AI commentary.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Coverage</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">30% → 75%</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Onboarding</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">
                    2 mo → 5 days
                  </h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Escalations</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">
                    &gt;50% Cut
                  </h4>
                </div>
              </div>
            </div>

            <!-- CTA with primary color from case study image -->
            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/vanguard"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-110 active:scale-[0.98] no-underline"
                style="background-color: #1d4ed8;"
              >
                <span>View case study</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 02: HelpNow+ -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-24 z-20 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <a
            href="/case-study/helpnow"
            class="block w-full lg:w-1/4 shrink-0 relative overflow-hidden group/img min-h-[220px] sm:min-h-[260px] lg:min-h-full self-stretch"
            title="View HelpNow+ Case Study"
          >
            <img
              src="/images/case-study-helpnow-selected.png"
              alt="HelpNow+ Case Study"
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-105"
            />
          </a>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS // 02 • VMWARE • SERVICE INFRASTRUCTURE
              </small>

              <h3 class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left">
                Workplace Support, Humanized
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                Transformed fragmented internal service portals into an
                omnichannel PWA. Reduced expensive support escalations while
                dramatically elevating employee satisfaction.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Savings</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">$36M+</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Productivity</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">2x Boost</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">CSAT</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">94%</h4>
                </div>
              </div>
            </div>

            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/helpnow"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-110 active:scale-[0.98] no-underline"
                style="background-color: #c25400;"
              >
                <span>View case study</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 03: DevHub -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-28 z-30 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <a
            href="/case-study/devhub"
            class="block w-full lg:w-1/4 shrink-0 relative overflow-hidden group/img min-h-[220px] sm:min-h-[260px] lg:min-h-full self-stretch"
            title="View DevHub Case Study"
          >
            <img
              src="/images/case-study-devhub-selected.png"
              alt="DevHub Case Study"
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-105"
            />
          </a>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS // 03 • VMWARE • DEVELOPER EXPERIENCE
              </small>

              <h3 class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left">
                Developer Ecosystem, Unified
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                Consolidated 14 disparate developer tools, SDK docs, and runtime
                environments into a single coherent portal for 20,000+
                engineers.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Scale</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">20k+ Devs</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Friction</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">-65%</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Unified</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">14 Tools</h4>
                </div>
              </div>
            </div>

            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/devhub"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-110 active:scale-[0.98] no-underline"
                style="background-color: #0079b8;"
              >
                <span>View case study</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 04: VLP (VMware Learning Platform) -->
        <article
          class="card p-0 top-0 lg:sticky lg:top-32 z-40 shadow-lg overflow-hidden flex flex-col lg:flex-row"
        >
          <!-- Left 1/4: Image filling 1/4 of the card -->
          <a
            href="/case-study/vlp"
            class="block w-full lg:w-1/4 shrink-0 relative overflow-hidden group/img min-h-[220px] sm:min-h-[260px] lg:min-h-full self-stretch"
            title="View VMware Learning Platform Case Study"
          >
            <img
              src="/images/case-study-vlp-selected.png"
              alt="VMware Learning Platform Case Study"
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-105"
            />
          </a>

          <!-- Right 3/4: Content -->
          <div
            class="w-full lg:w-3/4 p-6 sm:p-8 md:p-10 flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
          >
            <div class="w-full flex flex-col items-center lg:items-start">
              <small class="eyebrow mb-2 text-center lg:text-left">
                SYS // 04 • VMWARE • SAAS TRANSFORMATION
              </small>

              <h3 class="text-2xl sm:text-3xl font-bold mb-3 text-center lg:text-left">
                From Internal Tool to $1M+ SaaS
              </h3>

              <p
                class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-4 max-w-2xl mx-auto lg:mx-0 text-center lg:text-left"
              >
                Led the product design transformation that reshaped an aging
                internal infrastructure tool into a commercial cloud training
                platform, earning engineering trust and generating $1M+ ARR.
              </p>

              <!-- Impact Metrics: Compact with thin line between each, no card borders -->
              <div
                class="grid grid-cols-3 divide-x divide-black/10 my-4 py-1 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:flex lg:w-auto"
              >
                <div class="px-2 sm:px-6 lg:px-0 lg:pr-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Revenue</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">$1M+ ARR</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Scale</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">100k+ Labs</h4>
                </div>
                <div class="px-2 sm:px-6 lg:px-0 lg:pl-8 py-1 text-center lg:text-left">
                  <small class="eyebrow mb-1 text-center lg:text-left">Commercial</small>
                  <h4 class="text-lg sm:text-2xl font-bold mb-0 text-center lg:text-left">
                    15+ Partners
                  </h4>
                </div>
              </div>
            </div>

            <div
              class="pt-4 flex justify-center lg:justify-start w-full lg:w-auto"
            >
              <a
                href="/case-study/vlp"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-sm text-white transition-all duration-200 shadow-xs hover:shadow-md hover:brightness-110 active:scale-[0.98] no-underline"
                style="background-color: #4f46e5;"
              >
                <span>View case study</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>

  <!-- ========================================================================= -->
  <!-- ABOUT SECTION: PURPOSE & PLAY                                             -->
  <!-- ========================================================================= -->
  <section
    id="about"
    class="relative z-10 w-full py-24 md:py-32 bg-[var(--color-canvas)] border-t border-black/10"
  >
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-12 items-center mb-20 lg:mb-24">
        <!-- Text Column -->
        <div
          class="lg:col-span-6 flex flex-col items-center text-center lg:items-start lg:text-left"
        >
          <small class="eyebrow text-center lg:text-left">ABOUT // PHILOSOPHY</small>

          <h2 class="text-center lg:text-left">
            Rooted in Purpose <br class="hidden sm:block" />and Play.
          </h2>

          <p class="mx-auto lg:mx-0 text-center lg:text-left">
            Enterprise software doesn't have to feel like bureaucratic
            punishment. I lead inclusive, high-trust teams that tackle complex
            plumbing with curiosity, humor, and relentless craft.
          </p>

          <blockquote
            class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-8 text-center lg:text-left mx-auto lg:mx-0"
          >
            "Why messy enterprise plumbing? Because that's where the leverage
            is."
          </blockquote>

          <div class="flex justify-center lg:justify-start w-full">
            <a
              href="https://www.linkedin.com/in/tusharroy"
              target="_blank"
              class="btn-secondary"
            >
              <span>Connect on LinkedIn</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Video Frame -->
        <div class="lg:col-span-6">
          <figure class="m-0 text-center lg:text-left">
            <div class="media-frame aspect-video">
              <video
                autoplay
                loop
                muted
                playsinline
                class="w-full h-full object-cover"
              >
                <source src="/images/speaking-video.mp4" type="video/mp4" />
              </video>
            </div>
            <figcaption class="text-center lg:text-left">
              Keynote // Design Off-site • Sharing FY24 Design Vision
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- Testimonials Header -->
      <div class="pt-16 border-t border-black/10 mb-8 flex flex-col items-center lg:items-start text-center lg:text-left">
        <small class="eyebrow mb-0 text-center lg:text-left">PEER TELEMETRY // TESTIMONIALS</small>
      </div>

      <!-- Testimonials Grid -->
      <div class="grid lg:grid-cols-2 gap-8">
        <!-- Joy Busse -->
        <div
          class="card flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
        >
          <blockquote
            class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-4 text-center lg:text-left"
          >
            "Tushar brings people together. His energy and commitment led to a
            standout enterprise culture. From internal conferences to engaging
            podcasts, Tushar was the driving force behind many impactful
            initiatives."
          </blockquote>
          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-4 border-t border-black/10 w-full text-center sm:text-left lg:text-left"
          >
            <img
              src="/images/testimonial-joy.jpeg"
              alt="Joy Busse"
              class="w-10 h-10 rounded-full object-cover border border-black/10 shrink-0"
            />
            <div class="text-center sm:text-left lg:text-left">
              <small class="eyebrow m-0 font-bold text-center sm:text-left lg:text-left">Joy Busse</small>
              <figcaption class="m-0 text-center sm:text-left lg:text-left">
                Sr. Director of UX, Cribl
              </figcaption>
            </div>
          </div>
        </div>

        <!-- Razz Cortes-Maceda -->
        <div
          class="card flex flex-col justify-between items-center text-center lg:items-start lg:text-left"
        >
          <blockquote
            class="border-l-0 lg:border-l-3 border-[#f6c867] pl-0 lg:pl-6 my-4 text-center lg:text-left"
          >
            "Tushar's talents extend beyond design — he is a problem solver.
            His leadership of the UI dev team allowed us to stay on course. It
            would be a privilege to work with him again."
          </blockquote>
          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-4 border-t border-black/10 w-full text-center sm:text-left lg:text-left"
          >
            <img
              src="/images/testimonial-razz.jpeg"
              alt="Razz Cortes-Maceda"
              class="w-10 h-10 rounded-full object-cover border border-black/10 shrink-0"
            />
            <div class="text-center sm:text-left lg:text-left">
              <small class="eyebrow m-0 font-bold text-center sm:text-left lg:text-left">Razz Cortes-Maceda</small>
              <figcaption class="m-0 text-center sm:text-left lg:text-left">
                VP Digital Strategy, Bellco
              </figcaption>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- PODCAST SECTION: THOUGHT LEADERSHIP                                       -->
  <!-- ========================================================================= -->
  <section
    id="podcast"
    class="relative z-10 w-full py-24 md:py-32 bg-[var(--color-canvas)] border-t border-black/10"
  >
    <div
      class="max-w-6xl mx-auto px-6 flex flex-col items-center lg:items-start text-center lg:text-left"
    >
      <small class="eyebrow mb-2 text-center lg:text-left">THOUGHT LEADERSHIP</small>

      <h2 class="text-center lg:text-left">Beyond the Product.</h2>

      <!-- Podcast Card -->
      <div
        class="card p-8 md:p-12 grid lg:grid-cols-12 gap-8 items-center w-full"
      >
        <div
