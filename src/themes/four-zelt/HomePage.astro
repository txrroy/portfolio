  <!-- Micro-Interaction Scripts: Ramp Dot Grid & Cursor-Based Image Rotation -->
  <script>
    function setupRampDotGrid() {
      const heroSection = document.getElementById("hero-section");
      const canvas = document.getElementById(
        "hero-dot-grid",
      ) as HTMLCanvasElement | null;
      if (!heroSection || !canvas) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      interface Dot {
        baseX: number;
        baseY: number;
        x: number;
        y: number;
        size: number;
        alpha: number;
      }

      let dots: Dot[] = [];
      let width = 0;
      let height = 0;
      let dpr = 1;
      const SPACING = 28;
      const INFLUENCE_RADIUS = 140;
      const MAX_DISPLACEMENT = 12;
      const BASE_SIZE = 0.95;
      const BASE_ALPHA = 0.14;

      let mouse = {
        x: -9999,
        y: -9999,
        active: false,
        intensity: 0,
        targetIntensity: 0,
      };

      let stopTimeout: number | null = null;
      let animationFrameId: number | null = null;
      let isRunning = false;

      function resize() {
        const rect = heroSection.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        dots = [];
        const cols = Math.floor(width / SPACING);
        const rows = Math.floor(height / SPACING);
        const startX = (width - (cols - 1) * SPACING) / 2;
        const startY = (height - (rows - 1) * SPACING) / 2;

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const bx = startX + c * SPACING;
            const by = startY + r * SPACING;
            dots.push({
              baseX: bx,
              baseY: by,
              x: bx,
              y: by,
              size: BASE_SIZE,
              alpha: BASE_ALPHA,
            });
          }
        }

        renderStaticOrStart();
      }

      function renderFrame() {
        ctx.clearRect(0, 0, width, height);

        let needsMoreFrames = false;

        // Smoothly interpolate mouse intensity (fades out when mouse stops moving)
        const dIntensity = mouse.targetIntensity - mouse.intensity;
        mouse.intensity += dIntensity * 0.12;
        if (Math.abs(dIntensity) > 0.005) {
          needsMoreFrames = true;
        } else {
          mouse.intensity = mouse.targetIntensity;
        }

        // Subtle ambient saffron halo under cursor when moving
        if (mouse.active && mouse.intensity > 0.01) {
          const haloAlpha = 0.11 * mouse.intensity;
          const halo = ctx.createRadialGradient(
            mouse.x,
            mouse.y,
            0,
            mouse.x,
            mouse.y,
            INFLUENCE_RADIUS,
          );
          halo.addColorStop(0, `rgba(246, 200, 103, ${haloAlpha.toFixed(3)})`);
          halo.addColorStop(
            0.5,
            `rgba(246, 200, 103, ${(haloAlpha * 0.35).toFixed(3)})`,
          );
          halo.addColorStop(1, "rgba(246, 200, 103, 0)");
          ctx.fillStyle = halo;
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, INFLUENCE_RADIUS, 0, Math.PI * 2);
          ctx.fill();
        }

        const len = dots.length;
        for (let i = 0; i < len; i++) {
          const dot = dots[i];
          let targetX = dot.baseX;
          let targetY = dot.baseY;
          let targetSize = BASE_SIZE;
          let targetAlpha = BASE_ALPHA;
          let isHovered = false;

          if (mouse.active && mouse.intensity > 0.001) {
            const dx = dot.baseX - mouse.x;
            const dy = dot.baseY - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < INFLUENCE_RADIUS && dist > 0.001) {
              const factor = (1 - dist / INFLUENCE_RADIUS) * mouse.intensity;
              const easeFactor = factor * factor;

              // Subtle kinetic repulsion away from cursor scaled by motion intensity
              targetX = dot.baseX + (dx / dist) * easeFactor * MAX_DISPLACEMENT;
              targetY = dot.baseY + (dy / dist) * easeFactor * MAX_DISPLACEMENT;

              // Scale & illumination scaled by motion intensity
              targetSize = BASE_SIZE + factor * 0.95;
              targetAlpha = BASE_ALPHA + factor * 0.45;
              isHovered = true;
            }
          }

          // Smooth spring physics / lerp towards target
          const dxPos = targetX - dot.x;
          const dyPos = targetY - dot.y;
          const dSize = targetSize - dot.size;
          const dAlpha = targetAlpha - dot.alpha;

          dot.x += dxPos * 0.14;
          dot.y += dyPos * 0.14;
          dot.size += dSize * 0.14;
          dot.alpha += dAlpha * 0.14;

          if (
            Math.abs(dxPos) > 0.02 ||
            Math.abs(dyPos) > 0.02 ||
            Math.abs(dSize) > 0.01 ||
            Math.abs(dAlpha) > 0.01
          ) {
            needsMoreFrames = true;
          }

          // Draw individual dot
          ctx.beginPath();
          ctx.arc(dot.x, dot.y, dot.size, 0, Math.PI * 2);

          if (isHovered && dot.alpha > 0.25) {
            // Interactive high-contrast dark tone
            ctx.fillStyle = `rgba(24, 24, 27, ${dot.alpha.toFixed(3)})`;
          } else {
            // Baseline refined warm charcoal dot
            ctx.fillStyle = `rgba(45, 42, 38, ${dot.alpha.toFixed(3)})`;
          }
          ctx.fill();
        }

        if ((mouse.active && mouse.intensity > 0.001) || needsMoreFrames) {
          animationFrameId = requestAnimationFrame(renderFrame);
          isRunning = true;
        } else {
          isRunning = false;
          animationFrameId = null;
        }
      }

      function startAnimation() {
        if (!isRunning) {
          isRunning = true;
          animationFrameId = requestAnimationFrame(renderFrame);
        }
      }

      function renderStaticOrStart() {
        if (mouse.active && mouse.intensity > 0.001) {
          startAnimation();
        } else {
          renderFrame();
        }
      }

      function onMouseMove(e: MouseEvent) {
        const rect = heroSection.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
        mouse.targetIntensity = 1;

        if (stopTimeout) {
          clearTimeout(stopTimeout);
        }

        // When mouse stops moving, ease back to resting state after 180ms
        stopTimeout = window.setTimeout(() => {
          mouse.targetIntensity = 0;
          startAnimation();
        }, 180);

        startAnimation();
      }

      function onMouseLeave() {
        if (stopTimeout) {
          clearTimeout(stopTimeout);
        }
        mouse.active = false;
        mouse.targetIntensity = 0;
        mouse.x = -9999;
        mouse.y = -9999;
        startAnimation();
      }

      heroSection.addEventListener("mousemove", onMouseMove, { passive: true });
      heroSection.addEventListener("mouseleave", onMouseLeave, {
        passive: true,
      });
      window.addEventListener("resize", resize, { passive: true });

      resize();
    }

    function setupHeroImageRotation() {
      const heroSection = document.getElementById("hero-section");
      const portraitImg = document.getElementById("hero-portrait-img");
      if (!heroSection || !portraitImg) return;

      let ticking = false;

      function onMouseMove(e: MouseEvent) {
        if (ticking) return;
        ticking = true;

        requestAnimationFrame(() => {
          const rect = heroSection.getBoundingClientRect();
          const progress = Math.max(
            0,
            Math.min(1, (e.clientY - rect.top) / rect.height),
          );
          const rotation = 10 - progress * 20;

          portraitImg.style.transition =
            "transform 0.12s cubic-bezier(0.2, 0, 0, 1)";
          portraitImg.style.transform = `rotate(${rotation.toFixed(2)}deg)`;
          ticking = false;
        });
      }

      function onMouseLeave() {
        portraitImg.style.transition =
          "transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)";
        portraitImg.style.transform = "rotate(0deg)";
      }

      heroSection.addEventListener("mousemove", onMouseMove);
      heroSection.addEventListener("mouseleave", onMouseLeave);
    }

    setupRampDotGrid();
    setupHeroImageRotation();
    document.addEventListener("astro:page-load", () => {
      setupRampDotGrid();
      setupHeroImageRotation();
    });
  </script>
