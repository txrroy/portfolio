<script>
	// Paper Roll Down to View Floating Sticky Notes
	const continuousPaper = document.getElementById("continuous-paper");
	const floatingNotes = document.getElementById("floating-notes-backdrop");

	let isBent = false;

	function togglePaperBend(e) {
		if (e) e.stopPropagation();
		isBent = !isBent;
		if (continuousPaper) {
			continuousPaper.classList.toggle("paper-bent", isBent);
		}
		if (floatingNotes) {
			floatingNotes.classList.toggle("is-visible", isBent);
		}
		if (isBent) {
			window.scrollTo({ top: 0, behavior: "smooth" });
		}
		// Update indicator on the printer button
		const dot = document.getElementById("side-projects-dot");
		const btn = document.getElementById("btn-side-projects");
		if (dot && btn) {
			if (isBent) {
				dot.className =
					"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse";
				btn.classList.add(
					"border-amber-400/80",
					"text-amber-300",
					"bg-[#38332a]",
				);
			} else {
				dot.className = "w-1.5 h-1.5 rounded-full bg-amber-400";
				btn.classList.remove(
					"border-amber-400/80",
					"text-amber-300",
					"bg-[#38332a]",
				);
			}
		}
	}

	// Triggered from 'Side Projects' button on the printer chassis
	window.addEventListener("toggle-paper-bend", togglePaperBend);

	// =========================================================
	// TRANSPARENT CLIPPY (CLIPPIT) JUMP & DYNAMIC PERCHING
	// =========================================================
	const magicClippy = document.getElementById("magic-clippy");
	const clippyInner = document.getElementById("clippy-inner");
	const clippyAnchor = document.getElementById("clippy-home-anchor");
	const paperMainSheet = document.getElementById("paper-main-sheet");
	const caseStudyCards = document.querySelectorAll(".case-study-card");

	let currentActiveCard = null;
	let currentMode = "home";

	// Contextual speech messages
	const CLIPPY_MESSAGES = {
		home: "I am back as the first class netizen!",
		case1: "Learn how I improved security metrics trust across partner teams at Apple.",
		case2: "Learn how I improved developer velocity for 20,000+ engineers at Broadcom.",
		case3: "Learn how I improved workplace IT support with AI intent classification at VMware.",
		podcast:
			"Tune in! Learn how design leaders scale cohesive enterprise systems.",
		connect:
			"Let's connect! Always excited to chat about design systems & enterprise AI.",
	};

	const bubbleEl = document.getElementById("clippy-bubble");
	const bubbleTextEl = document.getElementById("clippy-bubble-text");
	const podcastAnchor = document.getElementById("podcast-clippy-anchor");
	const connectAnchor = document.getElementById("connect-clippy-anchor");

	function setClippyMessage(key) {
		if (bubbleTextEl && CLIPPY_MESSAGES[key]) {
			bubbleTextEl.textContent = CLIPPY_MESSAGES[key];
		}
	}

	function showBubble() {
		if (bubbleEl) {
			bubbleEl.classList.add("bubble-visible");
		}
	}

	function hideBubble() {
		if (bubbleEl) {
			bubbleEl.classList.remove("bubble-visible");
		}
	}

	function calculateHomeCoords() {
		if (!clippyAnchor || !paperMainSheet) return { x: 0, y: 0 };
		const aRect = clippyAnchor.getBoundingClientRect();
		const pRect = paperMainSheet.getBoundingClientRect();
		const halfHeight = clippyInner ? clippyInner.offsetHeight / 2 : 35;
		return {
			x: aRect.left - pRect.left,
			y: aRect.top - pRect.top + aRect.height / 2 - halfHeight,
			rotation: "0deg",
			scale: "1",
		};
	}

	function calculatePerchCoords(cardEl) {
		const btnAnchor = cardEl.querySelector(".case-study-clippy-anchor");
		if (!btnAnchor || !paperMainSheet) return calculateHomeCoords();
		const aRect = btnAnchor.getBoundingClientRect();
		const pRect = paperMainSheet.getBoundingClientRect();
		const halfHeight = clippyInner ? clippyInner.offsetHeight / 2 : 35;
		return {
			x: aRect.left - pRect.left,
			y: aRect.top - pRect.top + aRect.height / 2 - halfHeight,
			rotation: "0deg",
			scale: "1.02",
		};
	}

	function calculatePodcastCoords() {
		if (!podcastAnchor || !paperMainSheet) return calculateHomeCoords();
		const aRect = podcastAnchor.getBoundingClientRect();
		const pRect = paperMainSheet.getBoundingClientRect();
		const halfHeight = clippyInner ? clippyInner.offsetHeight / 2 : 35;
		return {
			x: aRect.left - pRect.left,
			y: aRect.top - pRect.top + aRect.height / 2 - halfHeight,
			rotation: "0deg",
			scale: "1.02",
		};
	}

	function calculateConnectCoords() {
		if (!connectAnchor || !paperMainSheet) return calculateHomeCoords();
		const aRect = connectAnchor.getBoundingClientRect();
		const pRect = paperMainSheet.getBoundingClientRect();
		const halfHeight = clippyInner ? clippyInner.offsetHeight / 2 : 35;
		return {
			x: aRect.left - pRect.left,
			y: aRect.top - pRect.top + aRect.height / 2 - halfHeight,
			rotation: "0deg",
			scale: "1.02",
		};
	}

	function moveClippyTo(
		x,
		y,
		isHome = false,
		rotation = "-5deg",
		scale = "1.06",
	) {
		if (!magicClippy) return;
		magicClippy.style.left = `${Math.round(x)}px`;
		magicClippy.style.top = `${Math.round(y)}px`;
		magicClippy.style.opacity = "1";

		if (isHome) {
			magicClippy.classList.add("clippy-idle");
			magicClippy.classList.remove("clippy-perched");
			if (clippyInner) {
				clippyInner.style.transform = "rotate(0deg) scale(1)";
			}
		} else {
			magicClippy.classList.remove("clippy-idle");
			magicClippy.classList.add("clippy-perched");
			if (clippyInner) {
				clippyInner.style.transform = `rotate(${rotation}) scale(${scale})`;
			}
		}
	}

	function jumpHome() {
		if (currentMode === "home") return;
		currentMode = "home";
		if (currentActiveCard) {
			currentActiveCard.classList.remove("clippy-active");
			currentActiveCard = null;
		}
		hideBubble();
		setClippyMessage("home");
		const home = calculateHomeCoords();
		moveClippyTo(home.x, home.y, true);
	}

	function jumpToCard(cardEl) {
		const caseIndex = cardEl.getAttribute("data-case-index") || "1";
		currentMode = "case" + caseIndex;
		if (currentActiveCard && currentActiveCard !== cardEl) {
			currentActiveCard.classList.remove("clippy-active");
		}
		currentActiveCard = cardEl;
		cardEl.classList.add("clippy-active");
		setClippyMessage("case" + caseIndex);

		const target = calculatePerchCoords(cardEl);
		moveClippyTo(target.x, target.y, false, target.rotation, target.scale);
	}

	function jumpToPodcast() {
		currentMode = "podcast";
		if (currentActiveCard) {
			currentActiveCard.classList.remove("clippy-active");
			currentActiveCard = null;
		}
		setClippyMessage("podcast");
		const target = calculatePodcastCoords();
		moveClippyTo(target.x, target.y, false, target.rotation, target.scale);
	}

	function jumpToConnect() {
		currentMode = "connect";
		if (currentActiveCard) {
			currentActiveCard.classList.remove("clippy-active");
			currentActiveCard = null;
		}
		setClippyMessage("connect");
		const target = calculateConnectCoords();
		moveClippyTo(target.x, target.y, false, target.rotation, target.scale);
	}

	function initClippy() {
		setClippyMessage("home");
		const home = calculateHomeCoords();
		moveClippyTo(home.x, home.y, true);
	}

	function isMovingTo(e, ...selectors) {
		const related = e.relatedTarget;
		if (!related || !related.closest) return false;
		return selectors.some((selector) => Boolean(related.closest(selector)));
	}

	// Case study mouse & focus event listeners
	caseStudyCards.forEach((card) => {
		card.addEventListener("mouseenter", () => {
			jumpToCard(card);
		});
		card.addEventListener("focus", () => {
			jumpToCard(card);
		});
		card.addEventListener("mouseleave", (e) => {
			if (isMovingTo(e, "#magic-clippy", ".case-study-card")) {
				return;
			}
			jumpHome();
		});
		card.addEventListener("blur", (e) => {
			if (isMovingTo(e, "#magic-clippy", ".case-study-card")) {
				return;
			}
			jumpHome();
		});

		// Hovering the button also displays the speech bubble
		const btn = card.querySelector(".case-study-btn");
		btn?.addEventListener("mouseenter", () => {
			showBubble();
		});
		btn?.addEventListener("mouseleave", (e) => {
			if (!isMovingTo(e, "#magic-clippy")) {
				hideBubble();
			}
		});
	});

	// If mouse leaves work section completely
	const workSection = document.getElementById("work");
	workSection?.addEventListener("mouseleave", (e) => {
		if (isMovingTo(e, "#magic-clippy")) return;
		jumpHome();
	});

	// Podcast section hover listeners
	const podcastSection = document.getElementById("podcast");
	const podcastLink = document.getElementById("podcast-spotify-link");
	podcastSection?.addEventListener("mouseenter", () => {
		jumpToPodcast();
	});
	podcastLink?.addEventListener("mouseenter", () => {
		showBubble();
	});
	podcastLink?.addEventListener("mouseleave", (e) => {
		if (!isMovingTo(e, "#magic-clippy")) {
			hideBubble();
		}
	});
	podcastSection?.addEventListener("mouseleave", (e) => {
		if (isMovingTo(e, "#magic-clippy", "#podcast")) {
			return;
		}
		jumpHome();
	});

	// Connect section hover listeners
	const connectSection = document.getElementById("connect");
	const connectBtn = document.getElementById("connect-linkedin-btn");
	connectSection?.addEventListener("mouseenter", () => {
		jumpToConnect();
	});
	connectBtn?.addEventListener("mouseenter", () => {
		showBubble();
	});
	connectBtn?.addEventListener("mouseleave", (e) => {
		if (!isMovingTo(e, "#magic-clippy")) {
			hideBubble();
		}
	});
	connectSection?.addEventListener("mouseleave", (e) => {
		if (isMovingTo(e, "#magic-clippy", "#connect")) {
			return;
		}
		jumpHome();
	});

	// Clippy direct hover listeners for speech bubble
	clippyInner?.addEventListener("mouseenter", () => {
		showBubble();
	});
	clippyInner?.addEventListener("mouseleave", (e) => {
		hideBubble();
		if (currentMode.startsWith("case")) {
			if (isMovingTo(e, ".case-study-card", "#magic-clippy")) return;
			jumpHome();
		} else if (currentMode === "podcast") {
			if (isMovingTo(e, "#podcast", "#magic-clippy")) return;
			jumpHome();
		} else if (currentMode === "connect") {
			if (isMovingTo(e, "#connect", "#magic-clippy")) return;
			jumpHome();
		}
	});

	// Hero headline anchor hover also triggers the bubble
	clippyAnchor?.parentElement?.addEventListener("mouseenter", () => {
		if (currentMode === "home") {
			showBubble();
		}
	});
	clippyAnchor?.parentElement?.addEventListener("mouseleave", () => {
		if (currentMode === "home") {
			hideBubble();
		}
	});

	// Recalculate positions on window resize
	window.addEventListener("resize", () => {
		if (currentMode === "home") {
			const home = calculateHomeCoords();
			moveClippyTo(home.x, home.y, true);
		} else if (currentMode.startsWith("case") && currentActiveCard) {
			const target = calculatePerchCoords(currentActiveCard);
			moveClippyTo(
				target.x,
				target.y,
				false,
				target.rotation,
				target.scale,
			);
		} else if (currentMode === "podcast") {
			const target = calculatePodcastCoords();
			moveClippyTo(
				target.x,
				target.y,
				false,
				target.rotation,
				target.scale,
			);
		} else if (currentMode === "connect") {
			const target = calculateConnectCoords();
			moveClippyTo(
				target.x,
				target.y,
				false,
				target.rotation,
				target.scale,
			);
		}
	});

	// Clicking Clippy triggers playful wiggle and temporary bubble speech
	clippyInner?.addEventListener("click", (e) => {
		e.stopPropagation();
		showBubble();
		if (clippyInner) {
			clippyInner.classList.remove("clippy-wiggling");
			void clippyInner.offsetWidth; // force reflow
			clippyInner.classList.add("clippy-wiggling");
			setTimeout(() => {
				clippyInner.classList.remove("clippy-wiggling");
			}, 600);
			setTimeout(() => {
				hideBubble();
			}, 2500);
		}
	});

	// Initial positioning and font load safety
	if (document.readyState === "loading") {
		window.addEventListener("DOMContentLoaded", initClippy);
	} else {
		initClippy();
	}

	if (document.fonts && document.fonts.ready) {
		document.fonts.ready.then(() => {
			if (currentMode === "home") {
				initClippy();
			}
		});
	}

	// Recheck after fonts load
	setTimeout(initClippy, 100);
	setTimeout(initClippy, 400);
	setTimeout(initClippy, 1000);

	if (window.ResizeObserver && clippyAnchor) {
		const ro = new ResizeObserver(() => {
			if (currentMode === "home") {
				initClippy();
			}
		});
		ro.observe(clippyAnchor);
	}
</script>
