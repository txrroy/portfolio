---
import Layout from "./Layout.astro";
import PrinterSvg from "../../components/PrinterSvg.astro";
---

<Layout
	title="Tushar Roy – Systematic by Design • Enterprise UX & Design Systems"
>
	<!-- Workspace Desk Background -->
	<div
		class="min-h-screen bg-[#141312] text-black relative pt-0 sm:pt-8 md:pt-12 selection:bg-neutral-300 font-space"
		id="top"
	>
		<!-- Subtle Desk Surface Grid Pattern -->
		<div
			class="absolute inset-0 opacity-[0.03] pointer-events-none"
			style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"
		>
		</div>

		<!-- ========================================================= -->
		<!-- FLOATING STICKY NOTES ON BLACK BACKGROUND (BEHIND PAPER)  -->
		<!-- Revealed when the continuous paper is bent downwards      -->
		<!-- ========================================================= -->
		<div
			id="floating-notes-backdrop"
			class="absolute top-10 sm:top-14 left-0 right-0 max-w-[1000px] mx-auto px-6 z-0 pointer-events-none flex flex-wrap items-center justify-center gap-6 sm:gap-10 md:gap-16 select-none font-space"
		>
			<!-- Sticky Note 01: kids gamified learning -->
			<div
				class="w-72 sm:w-80 bg-[#fef9c3] text-[#713f12] p-6 shadow-[12px_18px_36px_rgba(0,0,0,0.9),0_2px_4px_rgba(0,0,0,0.4)] transform -rotate-3 hover:rotate-0 transition-transform duration-300 relative pointer-events-auto floating-note-1"
			>
				<!-- Translucent frosted tape at top -->
				<div
					class="w-16 h-4 bg-white/75 backdrop-blur-xs absolute -top-2 left-1/2 -translate-x-1/2 shadow-xs rotate-1"
				>
				</div>
				<span
					class="text-[9px] uppercase tracking-wider text-[#854d0e] font-bold block mb-2"
					>NOTE 01</span
				>
				<h3
					class="font-bold text-xl uppercase tracking-tight text-[#422006] leading-tight mb-2"
				>
					kids gamified learning
				</h3>
				<p
					class="font-homemade text-base sm:text-lg text-[#713f12] leading-relaxed"
				>
					Tactile learning mechanics, spatial canvas models, and
					joyful narrative discovery for young explorers. Making math
					and literacy feel like play.
				</p>
			</div>

			<!-- Sticky Note 02: design system for AI -->
			<div
				class="w-72 sm:w-80 bg-[#e0f2fe] text-[#0369a1] p-6 shadow-[12px_18px_36px_rgba(0,0,0,0.9),0_2px_4px_rgba(0,0,0,0.4)] transform rotate-2 hover:rotate-0 transition-transform duration-300 relative pointer-events-auto floating-note-2"
			>
				<!-- Translucent frosted tape at top -->
				<div
					class="w-16 h-4 bg-white/75 backdrop-blur-xs absolute -top-2 left-1/2 -translate-x-1/2 shadow-xs -rotate-1"
				>
				</div>
				<span
					class="text-[9px] uppercase tracking-wider text-[#0284c7] font-bold block mb-2"
					>NOTE 02</span
				>
				<h3
					class="font-bold text-xl uppercase tracking-tight text-[#0c4a6e] leading-tight mb-2"
				>
					design system for AI
				</h3>
				<p
					class="font-homemade text-base sm:text-lg text-[#0369a1] leading-relaxed"
				>
					Token taxonomy for streaming LLMs, probabilistic UI
					components, human verification audit trails & agent markdown
					specs.
				</p>
			</div>
		</div>

		<!-- ========================================================= -->
		<!-- TRACTOR FEED CONTINUOUS PAPER (BORDERLESS VERSION)        -->
		<!-- ========================================================= -->
		<div
			id="continuous-paper"
			class="relative z-10 max-w-[1280px] mx-auto flex shadow-[0_20px_60px_rgba(0,0,0,0.8)] font-space"
		>
			<!-- Left Tractor Margin (Perforated Feed Holes + Vertical Spec) -->
			<div
				class="hidden sm:flex flex-col justify-between items-center py-12 tractor-feed-left select-none"
			>
				<span
					class="[writing-mode:vertical-rl] rotate-180 text-[9px] text-black/40 tracking-[0.2em] sticky top-24 font-space"
				>
					00.00 — 48.00 CM
				</span>
			</div>

			<!-- Main Continuous Sheet (White Computer Paper - Borderless) -->
			<div
				class="flex-1 bg-[#faf8f2] pt-6 md:pt-8 pb-16 relative overflow-hidden"
				id="paper-main-sheet"
			>
				<!-- Interactive Clippy Mascot (Microsoft Clippit) -->
				<div
					id="magic-clippy"
					class="absolute z-50 pointer-events-none opacity-0 select-none"
					style="left: 0px; top: 0px;"
					aria-hidden="true"
				>
					<div
						id="clippy-inner"
						class="relative cursor-pointer pointer-events-auto transition-transform duration-300 w-6 sm:w-8 md:w-10 flex flex-col items-center justify-center"
					>
						<!-- Retro Comic Speech Bubble (Positioned directly relative to Clippy's head) -->
						<div
							id="clippy-bubble"
							class="absolute bottom-[calc(100%+10px)] left-1/2 -translate-x-1/2 w-64 max-w-[270px] bg-[#ffffd9] border-1.5 border-black text-black shadow-[3px_3px_0_0_#000] p-2.5 sm:p-3 text-[11px] leading-snug rounded-xs font-space opacity-0 pointer-events-none transition-all duration-200 transform translate-y-1 z-60 text-center select-none"
						>
							<span
								id="clippy-bubble-text"
								class="block font-medium text-black text-center"
							>
								I am back as the first class netizen!
							</span>
							<!-- Speech Bubble Triangle Tail pointing straight down into head -->
							<div
								id="clippy-bubble-tail"
								class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[8px] border-t-black pointer-events-none"
							>
							</div>
							<div
								id="clippy-bubble-tail-inner"
								class="absolute -bottom-[6px] left-1/2 -translate-x-1/2 w-0 h-0 border-l-[5px] border-l-transparent border-r-[5px] border-r-transparent border-t-[7px] border-t-[#ffffd9] pointer-events-none"
							>
							</div>
						</div>

						<img
							src="/images/clippy.png"
							alt="Clippy"
							id="clippy-img"
							class="w-6 sm:w-8 md:w-10 h-auto select-none drop-shadow-[0_4px_12px_rgba(0,0,0,0.2)] block mx-auto"
							draggable="false"
						/>
					</div>
				</div>

				<!-- FRONT HERO SECTION (60vh Viewport-Aware Mono Layout) -->
				<div
					id="front-hero-content"
					class="px-6 sm:px-8 md:px-12 mb-16 font-space"
					style="height: 60vh; min-height: 60vh; display: flex; flex-direction: column; justify-content: space-between;"
				>
					<!-- Top Metadata Header (Dot-Matrix Dateline / Ticker) -->
					<div
						class="border-b-2 border-dashed border-black/20 pb-3 text-[10px] sm:text-[11px] text-black/60 w-full font-space shrink-0"
					>
						<div
							class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1.5 sm:gap-3 uppercase"
						>
							<div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
								<span class="font-bold text-black">PORTFOLIO</span>
								<span class="text-black/30 select-none">•</span>
								<span class="text-black/75">Enterprise UX Architect</span>
								<span class="hidden md:inline text-black/30 select-none">•</span>
								<span class="hidden md:inline text-black/60">San Francisco Bay Area</span>
							</div>
							<div
								class="flex items-center justify-between w-full sm:w-auto text-[9px] sm:text-[10px] text-black/45 pt-1.5 sm:pt-0 border-t border-black/5 sm:border-0"
							>
								<span class="md:hidden">San Francisco Bay Area</span>
								<span class="hidden sm:inline md:hidden text-black/30 mx-2">•</span>
								<span class="hidden sm:inline">FORM LENGTH: CONTINUOUS</span>
								<span class="hidden sm:inline text-black/30 mx-1.5">•</span>
								<span>BUFFER: 100% OK</span>
							</div>
						</div>
					</div>

					<!-- Vertically Centered Hero Lines -->
					<section
						class="flex-1 flex flex-col justify-center py-4 sm:py-6"
					>
						<div class="w-full">
							<!-- Role -->
							<span
								class="text-s uppercase tracking-[0.2em] text-black/60 block mb-3 font-semibold"
								>Tushar Roy
							</span>

							<!-- Name / Headline -->
							<h1
								class="whitespace-nowrap text-[clamp(1.1rem,5.2vw,1.9rem)] sm:text-5xl md:text-6xl lg:text-7xl font-normal tracking-tight text-normal leading-tight sm:leading-none mb-4 normal-case"
							>
								Systematic <span
									class="inline-flex items-baseline flex-nowrap shrink-0"
								>
									<span
										class="font-homemade font-normal normal-case text-[1em] text-[#0A66C2]"
										>by design</span
									><span
										id="clippy-home-anchor"
										class="inline-block w-[clamp(1rem,4vw,2rem)] h-[clamp(1rem,4vw,2rem)] sm:w-8 sm:h-8 md:w-10 md:h-10 ml-1 sm:ml-2.5 align-middle pointer-events-none shrink-0"
										aria-hidden="true"></span>
								</span>
							</h1>

							<!-- Tagline -->
							<p
								class="text-xl sm:text-2xl md:text-3xl text-black/85 font-normal leading-tight m-0 tracking-wide"
							>
								Building systems for humans and AI.
							</p>
						</div>
					</section>

					<!-- Bottom Perforation of the 80vh Hero Section -->
					<div
						class="border-b-2 border-dashed border-black/20 w-full shrink-0"
					>
					</div>
				</div>

				<!-- ===================================================== -->
				<!-- THREE CASE STUDIES SECTION (BORDERLESS EDITORIAL MONO) -->
				<!-- ===================================================== -->
				<section
					id="work"
					class="w-full scroll-mt-16 px-6 sm:px-8 md:px-12 mb-20 font-space"
				>
					<div class="flex flex-col">
						<!-- Case Study 01: Apple (AI Business Intelligence) -->
						<a
							href="/case-study/vanguard"
							class="case-study-card block group no-underline text-inherit cursor-pointer border-b-2 border-dashed border-black/20 pb-14 mb-14 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A66C2] focus-visible:ring-offset-4"
							data-case-index="1"
							aria-label="Read Case Study: The Security Trust Engine (Apple)"
						>
							<div
								class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-center"
							>
								<div
									class="md:col-span-5 flex flex-col justify-between h-full"
								>
									<div>
										<div
											class="flex items-center justify-between text-xs tracking-wider pb-2 mb-3"
										>
											<span
												class="text-black/80 font-bold uppercase"
												>DISPATCH 01 // AI BUSINESS
												INTELLIGENCE</span
											>
											<span
												class="text-[10px] uppercase font-bold text-black/60"
												>APPLE</span
											>
										</div>

										<h2
											class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight text-black mb-4 uppercase tracking-tight"
										>
											The Security Trust Engine
										</h2>

										<p
											class="text-xs sm:text-sm text-black/75 leading-relaxed mb-6 font-normal"
										>
											Architecting multi-tenant trust
											tiers, audit trails, and lineage
											telemetry for Apple's internal
											business intelligence systems.
										</p>

										<!-- Hashtags -->
										<div
											class="text-[11px] text-black/60 flex flex-wrap gap-2 mb-6"
										>
											<span>#EnterpriseAI</span>
											<span>#TrustTiers</span>
											<span>#DataLineage</span>
										</div>
									</div>

									<div class="flex items-center">
										<div
											class="case-study-btn inline-flex items-center gap-2.5 text-xs uppercase tracking-wider font-bold py-2.5 px-4 border transition-all duration-300"
										>
											<span>Read Case Study</span>
											<span
												class="transition-transform duration-300 group-hover:translate-x-1.5"
												>→</span
											>
										</div>
										<span
											class="case-study-clippy-anchor inline-block w-8 sm:w-10 h-8 sm:h-10 ml-2.5 pointer-events-none"
											aria-hidden="true"></span>
									</div>
								</div>

								<!-- Image: Project Vanguard -->
								<div
									class="case-study-img-wrapper md:col-span-7 overflow-hidden shadow-[0_6px_24px_rgba(0,0,0,0.12)] bg-black/5 relative rounded-sm"
								>
									<img
										src="/images/case-study/vanguard/platform-overview.png"
										alt="Project Vanguard Platform Overview"
										class="case-study-img w-full aspect-[16/10] object-cover"
									/>
									<div class="case-study-sheen"></div>
								</div>
							</div>
						</a>

						<!-- Case Study 02: Broadcom (Security & Compliance) -->
						<a
							href="/case-study/devhub"
							class="case-study-card block group no-underline text-inherit cursor-pointer border-b-2 border-dashed border-black/20 pb-14 mb-14 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A66C2] focus-visible:ring-offset-4"
							data-case-index="2"
							aria-label="Read Case Study: Developer Ecosystem, Unified (Broadcom)"
						>
							<div
								class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-center"
							>
								<div
									class="md:col-span-5 flex flex-col justify-between h-full"
								>
									<div>
										<div
											class="flex items-center justify-between text-xs tracking-wider pb-2 mb-3"
										>
											<span
												class="text-black/80 font-bold uppercase"
												>DISPATCH 02 // SECURITY &
												COMPLIANCE</span
											>
											<span
												class="text-[10px] uppercase font-bold text-black/60"
												>BROADCOM</span
											>
										</div>

										<h2
											class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight text-black mb-4 uppercase tracking-tight"
										>
											Developer Ecosystem, Unified
										</h2>

										<p
											class="text-xs sm:text-sm text-black/75 leading-relaxed mb-6 font-normal"
										>
											Consolidating fragmented developer
											portals and policy tools into a
											single high-velocity internal
											engineering workspace for 20,000+
											engineers.
										</p>

										<!-- Hashtags -->
										<div
											class="text-[11px] text-black/60 flex flex-wrap gap-2 mb-6"
										>
											<span>#DevEx</span>
											<span>#UnifiedSecurity</span>
											<span>#ComplianceMesh</span>
										</div>
									</div>

									<div class="flex items-center">
										<div
											class="case-study-btn inline-flex items-center gap-2.5 text-xs uppercase tracking-wider font-bold py-2.5 px-4 border transition-all duration-300"
										>
											<span>Read Case Study</span>
											<span
												class="transition-transform duration-300 group-hover:translate-x-1.5"
												>→</span
											>
										</div>
										<span
											class="case-study-clippy-anchor inline-block w-8 sm:w-10 h-8 sm:h-10 ml-2.5 pointer-events-none"
											aria-hidden="true"></span>
									</div>
								</div>

								<!-- Image: DevHub -->
								<div
									class="case-study-img-wrapper md:col-span-7 overflow-hidden shadow-[0_6px_24px_rgba(0,0,0,0.12)] bg-black/5 relative rounded-sm"
								>
									<img
										src="/images/case-study/devhub/dashboard.png"
										alt="DevHub Unified Developer Platform"
										class="case-study-img w-full aspect-[16/10] object-cover"
									/>
									<div class="case-study-sheen"></div>
								</div>
							</div>
						</a>

						<!-- Case Study 03: VMware (Enterprise Service Management) -->
						<a
							href="/case-study/helpnow"
							class="case-study-card block group no-underline text-inherit cursor-pointer border-b-2 border-dashed border-black/20 pb-14 mb-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A66C2] focus-visible:ring-offset-4"
							data-case-index="3"
							aria-label="Read Case Study: Workplace Support, Humanized (VMware)"
						>
							<div
								class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-center"
							>
								<div
									class="md:col-span-5 flex flex-col justify-between h-full"
								>
									<div>
										<div
											class="flex items-center justify-between text-xs tracking-wider pb-2 mb-3"
										>
											<span
												class="text-black/80 font-bold uppercase"
												>DISPATCH 03 // SERVICE
												MANAGEMENT</span
											>
											<span
												class="text-[10px] uppercase font-bold text-black/60"
												>VMWARE</span
											>
										</div>

										<h2
											class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight text-black mb-4 uppercase tracking-tight"
										>
											Workplace Support, Humanized
										</h2>

										<p
											class="text-xs sm:text-sm text-black/75 leading-relaxed mb-6 font-normal"
										>
											Reimagining enterprise IT and
											service operations across 35,000+
											employees with AI intent
											classification and unified support
											queues.
										</p>

										<!-- Hashtags -->
										<div
											class="text-[11px] text-black/60 flex flex-wrap gap-2 mb-6"
										>
											<span>#ServiceManagement</span>
											<span>#IntentAI</span>
											<span>#SelfService</span>
										</div>
									</div>

									<div class="flex items-center">
										<div
											class="case-study-btn inline-flex items-center gap-2.5 text-xs uppercase tracking-wider font-bold py-2.5 px-4 border transition-all duration-300"
										>
											<span>Read Case Study</span>
											<span
												class="transition-transform duration-300 group-hover:translate-x-1.5"
												>→</span
											>
										</div>
										<span
											class="case-study-clippy-anchor inline-block w-8 sm:w-10 h-8 sm:h-10 ml-2.5 pointer-events-none"
											aria-hidden="true"></span>
									</div>
								</div>

								<!-- Image: HelpNow -->
								<div
									class="case-study-img-wrapper md:col-span-7 overflow-hidden shadow-[0_6px_24px_rgba(0,0,0,0.12)] bg-black/5 relative rounded-sm"
								>
									<img
										src="/images/case-study/helpnow/hero.png"
										alt="HelpNow Workplace Support AI Platform"
										class="case-study-img w-full aspect-[16/10] object-cover"
									/>
									<div class="case-study-sheen"></div>
								</div>
							</div>
						</a>
					</div>
				</section>

				<!-- ===================================================== -->
				<!-- DESIGN SYSTEMS SECTION (BORDERLESS EDITORIAL MONO)    -->
				<!-- ===================================================== -->
				<section
					id="design-systems"
					class="px-6 sm:px-8 md:px-12 mb-20 scroll-mt-24 font-space"
				>
					<div
						class="border-b-2 border-dashed border-black/20 pb-14 mb-4"
					>
						<div
							class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-3"
						>
							<div>
								<span
									class="text-xs uppercase tracking-[0.2em] text-black/60 block mb-2"
								>
									Foundational Systems Philosophy
								</span>
								<h2
									class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-black m-0 uppercase"
								>
									Design Systems: The Convergence
								</h2>
							</div>
							<div
								class="text-xs text-black/60 self-start md:self-auto uppercase"
							>
								TRIAD: ENGINEERING • CRAFT • ACCESSIBILITY
							</div>
						</div>

						<div>
							<p
								class="text-base sm:text-lg text-black/85 leading-relaxed max-w-3xl mb-12 font-normal"
							>
								A resilient enterprise design system is more
								than a component kit. It is the shared
								operational discipline where <strong
									class="font-bold text-black"
									>engineering rigor</strong
								>, <strong class="font-bold text-black"
									>product craft</strong
								>, and an uncompromised commitment to <strong
									class="font-bold text-black"
									>accessibility</strong
								> converge to accelerate shipping without accumulating
								debt.
							</p>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
								<!-- Pillar 1: Engineering Rigor -->
								<div>
									<div
										class="text-[10px] text-black/50 uppercase font-bold mb-2"
									>
										01 // CODE ARCHITECTURE
									</div>
									<h3
										class="font-bold text-lg text-black mb-3 uppercase"
									>
										Engineering Rigor
									</h3>
									<p
										class="text-xs sm:text-sm text-black/75 leading-relaxed"
									>
										Deterministic tokens, headless component
										primitives, and CI/CD automated
										regression suites. Built to bridge
										design directly with TypeScript
										monorepos and AI-assisted code
										generation.
									</p>
								</div>

								<!-- Pillar 2: Product Design Craft -->
								<div>
									<div
										class="text-[10px] text-black/50 uppercase font-bold mb-2"
									>
										02 // USER EXPERIENCE
									</div>
									<h3
										class="font-bold text-lg text-black mb-3 uppercase"
									>
										Product Design Craft
									</h3>
									<p
										class="text-xs sm:text-sm text-black/75 leading-relaxed"
									>
										Subtle micro-interactions, deliberate
										spatial rhythm, and cognitive friction
										reduction. Transforming high-complexity
										enterprise tasks into humane, intuitive
										flows that teams rely on daily.
									</p>
								</div>

								<!-- Pillar 3: Accessibility as a Cause -->
								<div>
									<div
										class="text-[10px] text-black/50 uppercase font-bold mb-2"
									>
										03 // INCLUSION & EQUITY
									</div>
									<h3
										class="font-bold text-lg text-black mb-3 uppercase"
									>
										Accessibility Cause
									</h3>
									<p
