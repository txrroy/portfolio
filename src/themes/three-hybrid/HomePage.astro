  <!-- Micro-Interaction Script for Telemetry Ticket -->
  <script>
    function setupTelemetryTicket() {
      const ticket = document.getElementById("telemetry-ticket");
      const statusText = document.getElementById("rex-status-text");
      if (!ticket || !statusText) return;

      const statuses = [
        "● STATUS: ALL SYSTEMS NOMINAL",
        "● REX_STATUS: ASKING FOR A WALK 🐾",
        "● REX_STATUS: CHIEF MORALE OFFICER 🐕",
        "● PIPELINE: ZERO DATA DRIFT ⚡",
        "● FOCUS: ENTERPRISE AI LEVERAGE",
      ];
      let currentIndex = 0;

      ticket.addEventListener("click", () => {
        currentIndex = (currentIndex + 1) % statuses.length;
        statusText.textContent = statuses[currentIndex];
        ticket.classList.add("scale-[1.02]");
        setTimeout(() => ticket.classList.remove("scale-[1.02]"), 180);
      });
    }

    function setupHeroImageRotation() {
      const heroSection = document.getElementById("hero-section");
      const portraitImg = document.getElementById("hero-portrait-img");
      if (!heroSection || !portraitImg) return;

      let ticking = false;

      function onMouseMove(e: MouseEvent) {
        if (ticking) return;
        ticking = true;

        requestAnimationFrame(() => {
          const rect = heroSection.getBoundingClientRect();
          // Progress: 0 at top of hero/screen, 1 at bottom of hero section
          const progress = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
          // Flipped direction: top of screen = -10deg or +10deg
          const rotation = 10 - progress * 20;

          portraitImg.style.transition = "transform 0.12s cubic-bezier(0.2, 0, 0, 1)";
          portraitImg.style.transform = `rotate(${rotation.toFixed(2)}deg)`;
          ticking = false;
        });
      }

      function onMouseLeave() {
        portraitImg.style.transition = "transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)";
        portraitImg.style.transform = "rotate(0deg)";
      }

      heroSection.addEventListener("mousemove", onMouseMove);
      heroSection.addEventListener("mouseleave", onMouseLeave);
    }

    setupTelemetryTicket();
    setupHeroImageRotation();
    document.addEventListener("astro:page-load", () => {
      setupTelemetryTicket();
      setupHeroImageRotation();
    });
  </script>
