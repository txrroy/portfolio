---

---

<nav
    id="navbar"
    class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-[#faf7f2b3] backdrop-blur-[40px] backdrop-saturate-[180%] border border-[rgba(255,255,255,0.4)] transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] overflow-hidden w-auto rounded-3xl"
    style="box-shadow: 0 4px 24px #2d2a261a, 0 8px 40px #2d2a2614, inset 0 1px #fffc, inset 0 -1px #00000005;"
    data-state="closed"
>
    <!-- Header: Logo, Name, Role, Hamburger -->
    <div
        id="nav-inner"
        class="flex items-center justify-between gap-4 px-4 py-2 w-full min-w-[320px] sm:min-w-[400px] transition-all duration-500"
    >
        <!-- Left: Logo & Identity -->
        <a
            href="#"
            id="brand-link"
            class="flex items-center gap-3 text-[var(--color-text-primary)] hover:opacity-80 transition-opacity whitespace-nowrap pl-1 no-underline group/brand"
        >
            <div
                class="relative w-8 h-8 rounded-full overflow-hidden p-0.5 flex items-center justify-center"
            >
                <!-- Favicon (Default) -->
                <img
                    id="icon-logo"
                    src="/images/favicon.png"
                    alt="Logo"
                    class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300 opacity-100"
                />

                <!-- Arrow Up Icon (Hidden initially) -->
                <svg
                    id="icon-arrow"
                    class="absolute inset-0 m-auto translate-y-8 opacity-0 transition-all duration-300"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-text-primary)"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 19V5"></path>
                    <path d="M5 12l7-7 7 7"></path>
                </svg>
            </div>

            <span
                class="nav-text font-serif text-lg font-bold tracking-tight overflow-hidden transition-all duration-500"
                >Tushar Roy</span
            >
        </a>

        <!-- Divider -->
        <div
            class="nav-divider w-px h-6 bg-[var(--color-text-primary)]/10 transition-all duration-500"
        >
        </div>

        <!-- Role -->
        <span
            class="nav-role font-sans text-xs tracking-widest uppercase font-bold text-[var(--color-text-secondary)] whitespace-nowrap hidden sm:block overflow-hidden transition-all duration-500"
        >
            Product Designer
        </span>

        <!-- Hamburger -->
        <button
            id="hamburger"
            class="nav-hamburger flex flex-col justify-center gap-[5px] w-8 h-8 group ml-1 p-1 hover:bg-black/5 rounded-full transition-colors relative cursor-pointer overflow-hidden duration-500"
            aria-label="Toggle Menu"
        >
            <span
                class="w-5 mx-auto h-0.5 bg-[var(--color-text-primary)] transition-all duration-300 origin-center group-[.active]:rotate-45 group-[.active]:translate-y-[7px]"
            ></span>
            <span
                class="w-5 mx-auto h-0.5 bg-[var(--color-text-primary)] transition-all duration-300 group-[.active]:opacity-0"
            ></span>
            <span
                class="w-5 mx-auto h-0.5 bg-[var(--color-text-primary)] transition-all duration-300 origin-center group-[.active]:-rotate-45 group-[.active]:-translate-y-[7px]"
            ></span>
        </button>
    </div>

    <!-- Expanded Content Wrapper -->
    <div
        id="nav-wrapper"
        class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.25,1,0.5,1)]"
    >
        <div class="overflow-hidden">
            <div
                id="nav-content"
                class="px-6 pb-6 pt-2 flex flex-col gap-6 opacity-0 transition-opacity duration-300 delay-100"
            >
                <div class="h-px bg-[var(--color-text-primary)]/10 my-2"></div>

                <div
                    class="text-[10px] uppercase tracking-[0.2em] font-bold text-[var(--color-text-secondary)] opacity-60"
                >
                    Navigation
                </div>

                <nav class="flex flex-col gap-4">
                    <a
                        href="/#work"
                        class="menu-link flex items-center gap-4 text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors group no-underline"
                    >
                        <div
                            class="w-8 h-8 rounded-lg bg-black/5 flex items-center justify-center group-hover:bg-[var(--color-accent)]/20 transition-colors"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-70 group-hover:opacity-100 transition-opacity"
                            >
                                <rect
                                    x="2"
                                    y="7"
                                    width="20"
                                    height="14"
                                    rx="2"
                                    ry="2"></rect>
                                <path
                                    d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"
                                ></path>
                            </svg>
                        </div>
                        <div class="flex flex-col">
                            <span
                                class="font-medium text-lg text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors"
                                >Work</span
                            >
                        </div>
                    </a>
                    <a
                        href="/#about"
                        class="menu-link flex items-center gap-4 text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors group no-underline"
                    >
                        <div
                            class="w-8 h-8 rounded-lg bg-black/5 flex items-center justify-center group-hover:bg-[var(--color-accent)]/20 transition-colors"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-70 group-hover:opacity-100 transition-opacity"
                            >
                                <path
                                    d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                                ></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="flex flex-col">
                            <span
                                class="font-medium text-lg text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors"
                                >About</span
                            >
                        </div>
                    </a>
                </nav>

                <div class="h-px bg-[var(--color-text-primary)]/10 my-2"></div>

                <div
                    class="text-[10px] uppercase tracking-[0.2em] font-bold text-[var(--color-text-secondary)] opacity-60"
                >
                    Connect
                </div>

                <a
                    href="https://www.linkedin.com/in/tusharroy"
                    target="_blank"
                    class="menu-link flex items-center gap-4 text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors group no-underline"
                >
                    <div
                        class="w-8 h-8 rounded-lg bg-black/5 flex items-center justify-center group-hover:bg-[var(--color-accent)]/20 transition-colors"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="opacity-70 group-hover:opacity-100 transition-opacity"
                        >
                            <path
                                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                            ></path>
                            <rect x="2" y="9" width="4" height="12"></rect>
                            <circle cx="4" cy="4" r="2"></circle>
                        </svg>
                    </div>
                    <span class="font-medium text-lg">LinkedIn</span>
                    <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="opacity-30"
                    >
                        <path
                            d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                        ></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- Backdrop -->
<div
    id="backdrop"
    class="fixed inset-0 bg-black/20 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"
>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const navbar = document.getElementById("navbar");
        const hamburger = document.getElementById("hamburger");
        const backdrop = document.getElementById("backdrop");
        const navWrapper = document.getElementById("nav-wrapper");
        const navContent = document.getElementById("nav-content");
        const menuLinks = document.querySelectorAll(".menu-link");
        const iconLogo = document.getElementById("icon-logo");
        const iconArrow = document.getElementById("icon-arrow");
        const brandLink = document.getElementById("brand-link");

        let isMenuOpen = false;

        // Toggle Menu State
        function toggleMenu() {
            isMenuOpen = !isMenuOpen;

            if (isMenuOpen) {
                navbar.setAttribute("data-state", "open");
                navbar.setAttribute("data-scrolled", "false"); // Ensure expanded when manually opened

                navWrapper.classList.remove("grid-rows-[0fr]");
                navWrapper.classList.add("grid-rows-[1fr]");
                hamburger.classList.add("active");
                backdrop.classList.remove("hidden");

                // Reset content visibility to show Name/Role (reverting handleScroll effects)
                const navText = document.querySelector(".nav-text");
                const navDivider = document.querySelector(".nav-divider");
                const navRole = document.querySelector(".nav-role");
                const navHamburger = document.querySelector(".nav-hamburger");
                const navInner = document.getElementById("nav-inner");

                if (navText) {
                    navText.style.width = "";
                    navText.style.opacity = "";
                    navText.style.margin = "";
                }
                if (navRole) {
                    navRole.style.width = "";
                    navRole.style.opacity = "";
                }
                if (navDivider) {
                    navDivider.style.width = "";
                    navDivider.style.opacity = "";
                    navDivider.style.margin = "";
                    navDivider.style.height = "";
                }
                if (navInner) {
                    navInner.style.minWidth = "";
                    navInner.style.gap = "";
                    navInner.style.paddingLeft = "";
                    navInner.style.paddingRight = "";
                    navInner.style.justifyContent = "";
                }
                if (navHamburger) {
                    navHamburger.style.width = "";
                    navHamburger.style.margin = "";
                    navHamburger.style.padding = "";
                }

                // Reset navbar dimensions (but keep positioning if scrolled)
                if (navbar) {
                    navbar.style.width = ""; // Auto width
                    navbar.style.borderRadius = ""; // Default class radius
                }

                // Show Logo, Hide Arrow (Default Look)
                if (iconLogo) iconLogo.style.opacity = "1";
                if (iconArrow) {
                    iconArrow.classList.add("translate-y-8", "opacity-0");
                    iconArrow.style.opacity = "0";
                    iconArrow.style.transform = "translateY(2rem)";
                }

                setTimeout(() => backdrop.classList.remove("opacity-0"), 10);
                setTimeout(() => navContent.classList.remove("opacity-0"), 150);
            } else {
                navbar.setAttribute("data-state", "closed");
                // Reset scrolled state if needed or let handleScroll fix it
                navWrapper.classList.remove("grid-rows-[1fr]");
                navWrapper.classList.add("grid-rows-[0fr]");
                hamburger.classList.remove("active");
                backdrop.classList.add("opacity-0");
                setTimeout(() => backdrop.classList.add("hidden"), 300);
                navContent.classList.add("opacity-0");
                handleScroll(); // Re-apply scroll state check
            }
        }

        hamburger?.addEventListener("click", toggleMenu);
        backdrop?.addEventListener("click", toggleMenu);
        menuLinks.forEach((link) => link.addEventListener("click", toggleMenu));

        // Scroll Logic
        function handleScroll() {
            if (isMenuOpen) return; // Don't collapse if menu is open

            const scrollPosition = window.scrollY;
            const threshold = window.innerHeight * 0.2; // Trigger earlier, 20% of viewport

            const navInner = document.getElementById("nav-inner");
            const navText = document.querySelector(".nav-text");
            const navDivider = document.querySelector(".nav-divider");
            const navRole = document.querySelector(".nav-role");
            const navHamburger = document.querySelector(".nav-hamburger");

            if (scrollPosition > threshold) {
                // Scrolled: Collapse Navbar to Capsule
                navbar.setAttribute("data-scrolled", "true");

                // Scrolled: Hide Favicon, Show Arrow
                if (iconLogo) iconLogo.style.opacity = "0";
                if (iconArrow) {
                    iconArrow.classList.remove("translate-y-8", "opacity-0");
                    iconArrow.style.opacity = "1";
                    iconArrow.style.transform = "translateY(0)";
                }

                // Hide Text Elements
                if (navText) {
                    navText.style.width = "0";
                    navText.style.opacity = "0";
                    navText.style.margin = "0";
                }
                if (navRole) {
                    navRole.style.width = "0";
                    navRole.style.opacity = "0";
                }

                // Adjust Inner Layout for Capsule
                if (navInner) {
                    navInner.style.minWidth = "0";
                    navInner.style.gap = "12px"; // Reduce gap to zero
                    navInner.style.paddingLeft = "0rem"; // Reduce padding to 2px
                    navInner.style.paddingRight = "0rem";
                    navInner.style.justifyContent = "center"; // Override justify-between
                }

                if (brandLink) {
                    brandLink.style.paddingLeft = "0";
                }

                // Adjust Divider - keep it but tight
                if (navDivider) {
                    navDivider.style.height = "12px"; // Smaller divider
                }

                // Adjust Hamburger - ensure visible
                if (navHamburger) {
                    navHamburger.style.width = "";
                    navHamburger.style.opacity = "1";
                    navHamburger.style.pointerEvents = "auto";
                    navHamburger.style.padding = ""; // Reset padding if it was messed up
                    navHamburger.style.margin = "0"; // Remove ml-1
                }

                if (navbar) {
                    // Apply Capsule styles
                    navbar.style.width = "auto"; // Auto width to fit Arrow + Hamburger
                    navbar.style.borderRadius = "24px"; // rounded-full

                    // Keep it centered by resetting to CSS defaults
                    navbar.style.left = "";
                    navbar.style.right = "";
                    navbar.style.transform = "";
                }

                // Scroll to Top Link
                if (brandLink) {
                    brandLink.setAttribute("href", "#");
                    brandLink.onclick = (e) => {
                        e.preventDefault();
                        window.scrollTo({
                            top: 0,
                            behavior: "smooth",
                        });
                    };
                }
            } else {
                // Top: Expand Navbar
                navbar.setAttribute("data-scrolled", "false");

                // Top: Show Favicon, Hide Arrow
                if (iconLogo) iconLogo.style.opacity = "1";
                if (iconArrow) {
                    iconArrow.classList.add("translate-y-8", "opacity-0");
                    iconArrow.style.opacity = "0";
                    iconArrow.style.transform = "translateY(2rem)";
                }

                // Show elements
                if (navText) {
                    navText.style.width = "";
                    navText.style.opacity = "";
                    navText.style.margin = "";
                }
                if (navDivider) {
                    navDivider.style.height = ""; // Reset height
                    navDivider.style.width = "";
                    navDivider.style.opacity = "";
                    navDivider.style.margin = "";
                }
                if (navRole) {
                    navRole.style.width = "";
                    navRole.style.opacity = "";
                }
                if (navHamburger) {
                    navHamburger.style.width = "";
                    navHamburger.style.opacity = "";
                    navHamburger.style.padding = "";
                    navHamburger.style.margin = "";
                }

                if (navInner) {
                    navInner.style.minWidth = "";
                    navInner.style.gap = ""; // Reset to CSS default
                    navInner.style.paddingLeft = "";
                    navInner.style.paddingRight = "";
                    navInner.style.justifyContent = ""; // Reset to justify-between
                }

                if (navbar) {
                    // Reset styles
                    navbar.style.width = "";
                    navbar.style.borderRadius = "";
                    navbar.style.left = "";
                    navbar.style.right = "";
                    navbar.style.transform = "";
                }

                // Reset Link
                if (brandLink) {
                    brandLink.setAttribute("href", "/");
                    brandLink.onclick = null;
                }
            }
        }

        window.addEventListener("scroll", () =>
            requestAnimationFrame(handleScroll),
        );
        handleScroll(); // Initial Check
    });
</script>
