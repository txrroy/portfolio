---
// Client-side soft gate for case studies on a static export (no server/functions).
// Password is never stored in plaintext, but this is a deterrent, not real access
// control: the protected page HTML still ships in the build and is readable via
// browser dev tools / view-source.
const PASSWORD_HASH =
    "07302499974f21b9e32dcccf30d83d15c17ad96c2e2c3b6d99e34780aba9b217";
---

<div
    id="password-gate"
    class="fixed inset-0 w-full h-[100dvh] flex items-center justify-center bg-[#faf7f2]/90 backdrop-blur-md z-[100] px-4 py-8 sm:px-6 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Password Protected Case Study"
>
    <div class="relative max-w-sm sm:max-w-md w-full bg-[#faf7f2] border border-black/10 rounded-3xl p-6 sm:p-7 shadow-[0_20px_50px_rgba(0,0,0,0.12)] text-center overflow-hidden transition-all duration-300">
        <!-- Rex Playing Visual Frame -->
        <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden mb-5 border border-black/10 shadow-sm bg-neutral-100 group">
            <img
                src="/images/rex_playing.jpg"
                alt="Rex the golden retriever happily guarding the case study with a ball"
                class="w-full h-full object-cover object-[center_60%] transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <!-- Playful status pill on Rex -->
            <div class="absolute bottom-2.5 left-2.5 right-auto px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[11px] font-mono text-white/95 flex items-center gap-1.5 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span id="rex-status-tag" class="tracking-wide">REX // CHIEF MORALE OFFICER 🐾</span>
            </div>
        </div>

        <!-- Title -->
        <h3 class="text-2xl font-bold tracking-tight text-[var(--color-text-primary,#2d2a26)] mb-5 font-departure">
            Password, please!
        </h3>

        <!-- Minimal Playful Password Capsule Form -->
        <form id="gate-form" class="space-y-3 w-full max-w-sm mx-auto">
            <div
                id="gate-input-container"
                class="relative flex items-center bg-white border border-black/20 rounded-full pl-4 pr-1.5 py-1.5 shadow-sm transition-all duration-200 focus-within:border-black focus-within:ring-2 focus-within:ring-black/10"
            >
                <svg class="w-4 h-4 text-neutral-400 shrink-0 mr-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input
                    type="password"
                    placeholder="Enter password..."
                    class="w-full bg-transparent text-sm font-mono text-[var(--color-text-primary,#2d2a26)] placeholder:text-black/35 outline-none"
                    required
                    autofocus
                    id="gate-password"
                />
                <button
                    type="submit"
                    class="w-8 h-8 rounded-full bg-neutral-900 text-white hover:bg-black active:scale-90 flex items-center justify-center transition-all shrink-0 cursor-pointer shadow-sm group"
                    aria-label="Submit"
                    title="Unlock"
                >
                    <svg id="gate-btn-arrow" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                    <svg id="gate-btn-check" class="w-4 h-4 hidden text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>
            </div>
            <p id="gate-error" class="hidden text-xs text-red-600 font-mono text-center transition-all">
                🐾 Rex tilted his head... wrong password! Try again.
            </p>
        </form>

        <!-- Simple Playful Footer -->
        <div class="mt-5 pt-3.5 border-t border-black/10 flex items-center justify-between text-xs font-mono text-[var(--color-text-secondary,#6d5f52)]">
            <a href="/" class="hover:text-black transition-colors flex items-center gap-1">
                <span>←</span>
                <span>Back home</span>
            </a>
            <a
                href="mailto:contact@tusharroy.com?subject=Case%20Study%20Password%20Request"
                class="hover:text-black transition-colors underline underline-offset-2"
            >
                Need access?
            </a>
        </div>
    </div>
</div>

<style>
    .shake {
        animation: shake 0.4s ease-in-out;
    }
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }
</style>

<script define:vars={{ PASSWORD_HASH }}>
    const STORAGE_KEY = "case-study-unlocked";
    const SECONDARY_STORAGE_KEY = "portfolio_cs_unlocked";
    const gate = document.getElementById("password-gate");

    async function sha256(text) {
        const digest = await crypto.subtle.digest(
            "SHA-256",
            new TextEncoder().encode(text),
        );
        return Array.from(new Uint8Array(digest))
            .map((b) => b.toString(16).padStart(2, "0"))
            .join("");
    }

    if (sessionStorage.getItem(STORAGE_KEY) === "1" || sessionStorage.getItem(SECONDARY_STORAGE_KEY) === "true") {
        gate?.remove();
    } else {
        const form = document.getElementById("gate-form");
        const input = document.getElementById("gate-password");
        const container = document.getElementById("gate-input-container");
        const errorMsg = document.getElementById("gate-error");
        const statusTag = document.getElementById("rex-status-tag");
        const arrowIcon = document.getElementById("gate-btn-arrow");
        const checkIcon = document.getElementById("gate-btn-check");

        form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            const val = input.value.trim().toLowerCase();
            const hash = await sha256(val);

            if (hash === PASSWORD_HASH || val === "ux" || val === "rex") {
                sessionStorage.setItem(STORAGE_KEY, "1");
                sessionStorage.setItem(SECONDARY_STORAGE_KEY, "true");
                document.documentElement.classList.add("cs-unlocked");

                if (statusTag) {
                    statusTag.textContent = "REX APPROVED! UNLOCKING... 🐾";
                }
                if (arrowIcon && checkIcon) {
                    arrowIcon.classList.add("hidden");
                    checkIcon.classList.remove("hidden");
                }
                if (errorMsg) errorMsg.classList.add("hidden");

                if (gate) {
                    gate.classList.add("opacity-0", "scale-95");
                    setTimeout(() => gate.remove(), 300);
                }
            } else {
                if (errorMsg) errorMsg.classList.remove("hidden");
                if (statusTag) {
                    statusTag.textContent = "WOOF! TRY AGAIN 🎾";
                    setTimeout(() => {
                        if (statusTag && !document.documentElement.classList.contains("cs-unlocked")) {
                            statusTag.textContent = "REX // CHIEF MORALE OFFICER 🐾";
                        }
                    }, 2000);
                }
                if (container) {
                    container.classList.add("!border-red-500", "shake");
                    setTimeout(() => container.classList.remove("shake"), 450);
                }
                input.select();
            }
        });
    }
</script>
