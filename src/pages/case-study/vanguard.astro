			aria-modal="true"
			aria-label="Image Preview"
		>
			<!-- Top Bar with Close Button -->
			<div
				class="w-full max-w-6xl flex items-center justify-between text-white/80 pb-3 mb-2 font-departure text-xs tracking-wider border-b border-white/10"
			>
				<span id="zoom-title" class="truncate max-w-xl text-white/90"
					>Preview</span
				>
				<div class="flex items-center gap-3">
					<span class="text-white/40 hidden sm:inline text-[11px]"
						>[ESC to close]</span
					>
