---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
	title="Vanguard  — Self-Service Business Intelligence • Apple InfoSec Case Study"
>
	<div
		class="min-h-screen bg-[#faf8f2] text-[#1a1918] antialiased selection:bg-black selection:text-white"
	>
		<!-- Sticky Top Navigation Bar -->
		<header
			class="sticky top-0 z-40 bg-[#faf8f2]/95 backdrop-blur-md border-b border-black/15 py-3.5 px-6"
		>
			<div
				class="max-w-6xl mx-auto flex items-center justify-between font-departure text-xs uppercase tracking-wider"
			>
				<a
					href="/"
					class="flex items-center gap-2 text-black hover:text-neutral-600 transition-colors no-underline"
				>
					<span>←</span>
					<span>Selected Works</span>
				</a>
				<div class="hidden sm:flex items-center gap-3 text-black/60">
					<span>Apple InfoSec</span>
					<span>•</span>
					<span class="text-black font-bold">Vanguard </span>
					<span>•</span>
					<span>Lead Product Designer</span>
				</div>
			</div>
		</header>

		<!-- Case Study Main Container -->
		<main class="max-w-6xl mx-auto px-6 sm:px-8 pt-12 md:pt-16 pb-28">
			<!-- ===================================================== -->
			<!-- SECTION 1: HERO & TITLE (PAGE 1)                      -->
			<!-- ===================================================== -->
			<article class="mb-20 md:mb-28 border-b border-black/15 pb-16">
				<!-- Kicker -->
				<div
					class="flex flex-wrap items-center justify-between gap-3 mb-4"
				>
					<span
						class="font-homemade text-base sm:text-lg text-black/75 normal-case block"
					>
						Making Security Work Measurable
					</span>
					<span
						class="font-departure text-[11px] uppercase tracking-wider px-2 py-0.5 bg-black/5 text-black/70 border border-black/10"
					>
						Vanguard
					</span>
				</div>

				<!-- Main Titles -->
				<h1
					class="font-departure text-4xl sm:text-5xl md:text-6xl font-normal text-black mb-3 leading-tight tracking-tight"
				>
					Self-Service Business Intelligence
				</h1>

				<!-- Executive Summary / Lead Paragraph -->
				<div
					class="font-sans text-lg sm:text-xl text-black/85 leading-relaxed space-y-4 max-w-4xl mb-10"
				>
					<p>
						The InfoSec organization at Apple struggled to answer
						one question: <em>"How are we keeping Apple safe?"</em>.
					</p>
					<p>
						I led the Business Intelligence (BI) team to build a <strong
							>governed self-service intelligence platform</strong
						> that provided a clear, consistent, and defendable answer
						using <strong>AI for speed</strong> and <strong
							>human validation for trust</strong
						> — helping Apple leaders make informed decisions timely,
						and with confidence.
					</p>
				</div>

				<!-- Full Width Hero Image: [ full width vg1_homepage.png ] -->
				<div
					class="border-2 border-black bg-white p-2.5 sm:p-4 shadow-[5px_5px_0_0_#000] mb-4 group relative"
				>
					<div
						class="relative overflow-hidden bg-neutral-900 border border-black/15"
					>
						<img
							src="/images-vanguard/vg1_homepage.png"
							alt="Vanguard  Homepage Interface - Executive Security Health Overview"
							class="w-full h-auto object-cover block cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
							loading="eager"
						/>
						<div
							class="absolute bottom-3 right-3 bg-black/85 text-white font-departure text-[10px] tracking-wider uppercase px-2.5 py-1 backdrop-blur-sm border border-white/20 flex items-center gap-1.5 pointer-events-none"
						>
							<svg
								class="w-3 h-3 text-white"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"
								></path></svg
							>
							<span>Click to expand</span>
						</div>
					</div>
				</div>
				<figcaption
					class="font-departure text-xs text-black/60 tracking-wider block mb-12"
				>
					Vanguard : Central executive dashboard displaying governed
					security metrics with live trust tiers and anomaly alerts.
				</figcaption>

				<!-- Metadata Matrix Box: Role and Timeline Panel -->
				<div
					class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-white border border-black/15 p-6 shadow-[3px_3px_0_0_#000] font-departure text-xs"
				>
					<div>
						<span
							class="text-black/50 block uppercase tracking-wider mb-1.5 font-semibold"
							>Role & Timeline</span
						>
						<strong class="font-bold text-black text-sm block mb-1"
							>Lead Product Designer</strong
						>
						<span class="text-black/75 block leading-relaxed">
							Strategy, interaction model, governance design.
						</span>
						<span class="text-black/50 block mt-1"
							>2025 Q3 — 2026 Q2</span
						>
					</div>
					<div>
						<span
							class="text-black/50 block uppercase tracking-wider mb-1.5 font-semibold"
							>Team</span
						>
						<strong class="font-bold text-black text-sm block mb-1"
							>Core & Partner Teams</strong
						>
						<span class="text-black/75 block leading-relaxed">
							1 Designer (me), 4 Developers, 2 Data engineers, 1
							PM, 1 SME, partner security orgs.
						</span>
					</div>
					<div>
						<span
							class="text-black/50 block uppercase tracking-wider mb-1.5 font-semibold"
							>Outcome</span
						>
						<div
							class="text-emerald-700 font-bold text-sm block mb-1"
						>
							BI Coverage: 30% → 75%
						</div>
						<span class="text-black/75 block leading-relaxed">
							Escalation calls during incidents cut by more than
							half. Onboarding dropped from 2 months → 5 days.
						</span>
					</div>
				</div>
			</article>

			<!-- ===================================================== -->
			<!-- TWO-COLUMN LAYOUT BEGINS HERE (AFTER PANEL)           -->
			<!-- Left Column: 25% (Kicker in handwritten + Title)      -->
			<!-- Right Column: 75% (Body text and images)              -->
			<!-- ===================================================== -->

			<!-- ===================================================== -->
			<!-- SECTION 2: CONTEXT                                    -->
			<!-- ===================================================== -->
			<article class="mb-20 md:mb-28 border-b border-black/15 pb-16">
				<div
					class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start"
				>
					<!-- Left Column: 25% -->
					<div class="md:col-span-3 md:sticky md:top-20">
						<span
							class="font-homemade text-base sm:text-lg text-black/75 normal-case block mb-1"
						>
							Context & Charter
						</span>
						<h2
							class="font-departure text-xl sm:text-2xl font-bold text-black normal-case leading-snug tracking-tight m-0"
						>
							Vanguard Business Intelligence (BI)
						</h2>
					</div>

					<!-- Right Column: 75% -->
					<div class="md:col-span-9 space-y-6">
						<div
							class="font-sans text-lg text-black/85 leading-relaxed space-y-4"
						>
							<p>
								The BI team's charter was to publish performance
								metrics for senior leadership and partner teams
								to help make strategic, forward-looking
								decisions.
							</p>
							<p>
								They closely worked with each partner team to
								hand-build metrics — defining the measure,
								negotiating the formula, working with multiple
								data engineering teams, publishing, and handling
								ongoing maintenance.
							</p>
							<p class="font-medium text-black">
								Metrics published in Vanguard were the single
								source of trusted truth for Apple leadership.
							</p>
						</div>

						<!-- Images: [vg2_mttd_metric.png] [vg2_programs.png] -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
							<div
								class="border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group"
							>
								<div
									class="bg-neutral-100 border border-black/15 overflow-hidden relative"
								>
									<img
										src="/images-vanguard/vg2_mttd_metric.png"
										alt="Mean Time to Detect (MTTD) Metric View"
										class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
									/>
									<div
										class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
									>
										MTTD Detail
									</div>
								</div>
								<div class="mt-2 text-center">
									<span
										class="font-departure text-[11px] text-black/60"
										>Single Metric Detail View (MTTD)</span
									>
								</div>
							</div>

							<div
								class="border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group"
							>
								<div
									class="bg-neutral-100 border border-black/15 overflow-hidden relative"
								>
									<img
										src="/images-vanguard/vg2_programs.png"
										alt="Vanguard Security Programs Inventory"
										class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
									/>
									<div
										class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
									>
										Programs Catalog
									</div>
								</div>
								<div class="mt-2 text-center">
									<span
										class="font-departure text-[11px] text-black/60"
										>Vanguard Security Programs Catalog</span
									>
								</div>
							</div>
						</div>
						<figcaption
							class="font-departure text-xs text-black/60 tracking-wider block"
						>
							Early Vanguard metrics and program structures were
							manually maintained by a central BI squad.
						</figcaption>
					</div>
				</div>
			</article>

			<!-- ===================================================== -->
			<!-- SECTION 3: THE PROBLEM                                -->
			<!-- ===================================================== -->
			<article class="mb-20 md:mb-28 border-b border-black/15 pb-16">
				<div
					class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start"
				>
					<!-- Left Column: 25% -->
					<div class="md:col-span-3 md:sticky md:top-20">
						<span
							class="font-homemade text-base sm:text-lg text-black/75 normal-case block mb-1"
						>
							The Problem
						</span>
						<h2
							class="font-departure text-xl sm:text-2xl font-bold text-black normal-case leading-snug tracking-tight m-0"
						>
							Executives had no defensible way to answer ‘How are
							we keeping Apple safe?’
						</h2>
					</div>

					<!-- Right Column: 75% -->
					<div class="md:col-span-9 space-y-6">
						<div
							class="font-sans text-lg text-black/85 leading-relaxed space-y-4"
						>
							<p>
								The small BI team could only cover <strong
									>~30% of the security teams</strong
								>. Others ended up creating their own dashboards
								to share with leadership directly. Executives
								were struggling for one holistic view they could
								trust.
							</p>
						</div>

						<!-- Design Goals Box -->
						<div
							class="bg-white border border-black/20 p-5 sm:p-6 shadow-[3px_3px_0_0_#000]"
						>
							<span
								class="font-departure text-xs font-bold uppercase tracking-wider text-black block mb-3"
							>
								My Design Goals:
							</span>
							<ul
								class="space-y-3 font-sans text-base text-black/85 list-none pl-0"
							>
								<li class="flex items-start gap-3">
									<span
										class="font-departure text-black font-bold"
										>01.</span
									>
									<span
										><strong>Increase BI coverage</strong> — through
										simplified or faster onboarding.</span
									>
								</li>
								<li class="flex items-start gap-3">
									<span
										class="font-departure text-black font-bold"
										>02.</span
									>
									<span
										><strong
											>Design and implement a holistic
											view for leadership</strong
										> — using a top-down results map.</span
									>
								</li>
								<li class="flex items-start gap-3">
									<span
										class="font-departure text-black font-bold"
										>03.</span
									>
									<span
										><strong
											>Improve the platform interface</strong
										> — to better the dashboards of non-BI teams.</span
									>
								</li>
							</ul>
						</div>

						<!-- Images: [vg3_results_map.png] [vg3_impact_metrics.png] [vg3_incident_management.png] -->
						<div
							class="grid grid-cols-1 sm:grid-cols-12 gap-5 pt-2"
						>
							<!-- Results Map (Left, Larger) -->
							<div
								class="sm:col-span-7 border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group"
							>
								<div
									class="bg-neutral-100 border border-black/15 overflow-hidden relative"
								>
									<img
										src="/images-vanguard/vg3_results_map.png"
										alt="Top-down Results Map for Leadership"
										class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
									/>
									<div
										class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
									>
										Top-Down Results Map
									</div>
								</div>
								<div class="mt-2 text-center">
									<span
										class="font-departure text-[11px] text-black/60"
										>Holistic leadership view: mapping
										strategic goals to measures</span
									>
								</div>
							</div>

							<!-- Impact Metrics & Incident Management (Right, Stacked) -->
							<div class="sm:col-span-5 flex flex-col gap-5">
								<div
									class="border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group flex-1"
								>
									<div
										class="bg-neutral-100 border border-black/15 overflow-hidden relative"
									>
										<img
											src="/images-vanguard/vg3_impact_metrics.png"
											alt="Impact Metrics Breakdown"
											class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
										/>
										<div
											class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
										>
											Impact Metrics
										</div>
									</div>
									<div class="mt-2 text-center">
										<span
											class="font-departure text-[11px] text-black/60"
											>High-level security impact metrics</span
										>
									</div>
								</div>

								<div
									class="border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group flex-1"
								>
									<div
										class="bg-neutral-100 border border-black/15 overflow-hidden relative"
									>
										<img
											src="/images-vanguard/vg3_incident_management.png"
											alt="Incident Management Dashboard"
											class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
										/>
										<div
											class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
										>
											Incident Management
										</div>
									</div>
									<div class="mt-2 text-center">
										<span
											class="font-departure text-[11px] text-black/60"
											>Non-BI team dashboard integration</span
										>
									</div>
								</div>
							</div>
						</div>
						<figcaption
							class="font-departure text-xs text-black/60 tracking-wider block"
						>
							Connecting top-level strategic security objectives
							to team-level operational metrics.
						</figcaption>
					</div>
				</div>
			</article>

			<!-- ===================================================== -->
			<!-- SECTION 4: RESEARCH                                   -->
			<!-- ===================================================== -->
			<article class="mb-20 md:mb-28 border-b border-black/15 pb-16">
				<div
					class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start"
				>
					<!-- Left Column: 25% -->
					<div class="md:col-span-3 md:sticky md:top-20">
						<span
							class="font-homemade text-base sm:text-lg text-black/75 normal-case block mb-1"
						>
							Field Research
						</span>
						<h2
							class="font-departure text-xl sm:text-2xl font-bold text-black normal-case leading-snug tracking-tight m-0"
						>
							Metrics went stale, and anomalies unexplained
						</h2>
					</div>

					<!-- Right Column: 75% -->
					<div class="md:col-span-9 space-y-6">
						<div
							class="font-sans text-lg text-black/85 leading-relaxed space-y-4"
						>
							<p>
								I started with a <strong>design sprint</strong> with
								the BI team to align on goals and map how a metric
								actually gets made. Then I ran interviews on both
								ends of the pipe.
							</p>
							<p>
								I found onboarding was slow (<strong
									>average 2 months</strong
								>) primarily due to iteration between the two
								teams. Also, different teams had a variety of
								dashboards — using varied metrics across the
								board.
							</p>
							<p>
								My conversations with partner teams and
								executives uncovered two underlying challenges:
							</p>
						</div>

						<!-- Two Core Challenges Cards -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
							<div
								class="bg-white border-2 border-black p-5 sm:p-6 shadow-[3px_3px_0_0_#000]"
							>
								<div class="flex items-center gap-2 mb-3">
									<h3
										class="font-departure text-sm font-bold text-black m-0"
									>
										1. Published metrics went stale soon
									</h3>
								</div>
								<p
									class="font-sans text-sm text-black/75 leading-relaxed m-0"
								>
									Teams had to spend a lot of time
									continuously working with the BI team to
									maintain their metrics, and back-and-forth
									caused more friction than help.
								</p>
							</div>

							<div
								class="bg-white border-2 border-black p-5 sm:p-6 shadow-[3px_3px_0_0_#000]"
							>
								<div class="flex items-center gap-2 mb-3">
									<h3
										class="font-departure text-sm font-bold text-black m-0"
									>
										2. Anomalies were displayed, but not
										explained
									</h3>
								</div>
								<p
									class="font-sans text-sm text-black/75 leading-relaxed m-0"
								>
									When a metric spiked, there was a flurry of
									questions, check-ins, and chaos as
									leadership wanted to understand the full
									picture.
								</p>
							</div>
						</div>

						<!-- Images: [vg5.png] [vg6.png] -->
						<div class="space-y-5 pt-2">
							<div
								class="border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group"
							>
								<div
									class="bg-neutral-100 border border-black/15 overflow-hidden relative"
								>
									<img
										src="/images-vanguard/vg5.png"
										alt="Research Findings: Onboarding Friction and Maintenance Choke Points"
										class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
									/>
									<div
										class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
									>
										Research Discovery Map
									</div>
								</div>
								<div class="mt-2 text-center">
									<span
										class="font-departure text-[11px] text-black/60"
										>Mapping the metric authoring lifecycle
										and identifying failure points</span
									>
								</div>
							</div>

							<div
								class="border-2 border-black bg-white p-3 shadow-[4px_4px_0_0_#000] group"
							>
								<div
									class="bg-neutral-100 border border-black/15 overflow-hidden relative"
								>
									<img
										src="/images-vanguard/vg6.png"
										alt="Metric Workflow and Back-and-Forth Handoff Friction"
										class="w-full h-auto object-contain cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
									/>
									<div
										class="absolute bottom-2 right-2 bg-black/80 text-white font-departure text-[9px] uppercase px-2 py-0.5 pointer-events-none"
									>
										Process Latency Analysis
									</div>
								</div>
								<div class="mt-2 text-center">
									<span
										class="font-departure text-[11px] text-black/60"
										>The 2-month handoff bottleneck between
										partner teams and central BI</span
									>
								</div>
							</div>
						</div>
						<figcaption
							class="font-departure text-xs text-black/60 tracking-wider block"
						>
							Visualizing the iterative bottlenecks that made
							central metrics lag operational realities.
						</figcaption>
					</div>
				</div>
			</article>

			<!-- ===================================================== -->
			<!-- SECTION 5: STRATEGY & REFRAMING                       -->
			<!-- ===================================================== -->
			<article class="mb-20 md:mb-28 border-b border-black/15 pb-16">
				<div
					class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start"
				>
					<!-- Left Column: 25% -->
					<div class="md:col-span-3 md:sticky md:top-20">
						<span
							class="font-homemade text-base sm:text-lg text-black/75 normal-case block mb-1"
						>
							Core Strategy
						</span>
						<h2
							class="font-departure text-xl sm:text-2xl font-bold text-black normal-case leading-snug tracking-tight m-0"
						>
							The team had two plans. I argued for one.
						</h2>
					</div>

					<!-- Right Column: 75% -->
					<div class="md:col-span-9 space-y-6">
						<!-- Design Sprint Dialogue Box -->
						<div
							class="bg-white border-2 border-black p-6 sm:p-8 shadow-[4px_4px_0_0_#000] font-sans"
						>
							<div
