<script>
	// -------------------------------------------------------------
	// 1. Image Overlay / Lightbox Logic
	// -------------------------------------------------------------
	const overlay = document.getElementById("image-zoom-overlay");
	const zoomImg = document.getElementById(
		"image-zoom-img",
	) as HTMLImageElement;
	const zoomTitle = document.getElementById("zoom-title");
	const closeBtn = document.getElementById("image-zoom-close");
	let isZoomOpen = false;

	function openZoom(src: string, alt: string) {
		if (!overlay || !zoomImg) return;
		zoomImg.src = src;
		zoomImg.alt = alt || "Case Study Visual";
		if (zoomTitle) {
			zoomTitle.textContent = alt || "Visual Inspection";
		}
		overlay.classList.remove("hidden");
		requestAnimationFrame(() => {
			overlay.classList.remove("opacity-0");
		});
		document.body.style.overflow = "hidden";
		isZoomOpen = true;
	}

	function closeZoom() {
		if (!overlay) return;
		overlay.classList.add("opacity-0");
		setTimeout(() => {
			overlay.classList.add("hidden");
			if (zoomImg) zoomImg.src = "";
		}, 300);
		document.body.style.overflow = "";
		isZoomOpen = false;
	}

	// Register all clickable images in main
	const allImages = document.querySelectorAll("main img");
	allImages.forEach((img) => {
		(img as HTMLElement).style.cursor = "zoom-in";
		img.addEventListener("click", (e) => {
			const target = e.currentTarget as HTMLImageElement;
			openZoom(target.src, target.alt);
		});
	});

	// Close actions
	closeBtn?.addEventListener("click", closeZoom);
	overlay?.addEventListener("click", (e) => {
		if (
			e.target === overlay ||
			(e.target as HTMLElement).id === "zoom-title"
		) {
			closeZoom();
		}
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && isZoomOpen) {
			closeZoom();
		}
	});

	// -------------------------------------------------------------
	// 2. Authoring Onboarding Carousel (Fade-in Auto Carousel)
	// -------------------------------------------------------------
	const slides = document.querySelectorAll<HTMLElement>(".carousel-slide");
	const indicator = document.getElementById("carousel-indicator");
	const stepTitle = document.getElementById("carousel-step-title");
	const pills = document.querySelectorAll<HTMLButtonElement>(".step-pill");
	const prevBtn = document.getElementById("carousel-prev");
	const nextBtn = document.getElementById("carousel-next");
	const carouselContainer = document.getElementById("authoring-carousel");

	let currentStep = 0;
	let carouselInterval: ReturnType<typeof setInterval> | null = null;
	const totalSlides = slides.length;

	function showStep(index: number) {
		if (totalSlides === 0) return;
		currentStep = (index + totalSlides) % totalSlides;

		slides.forEach((slide, i) => {
			if (i === currentStep) {
				slide.classList.remove("opacity-0", "pointer-events-none");
				slide.classList.add("opacity-100", "active");
			} else {
				slide.classList.add("opacity-0", "pointer-events-none");
				slide.classList.remove("opacity-100", "active");
			}
		});

		const activeSlide = slides[currentStep];
		const title =
			activeSlide.getAttribute("data-title") || `Step ${currentStep + 1}`;
		if (indicator)
			indicator.textContent = `Step ${currentStep + 1} of ${totalSlides}`;
		if (stepTitle) stepTitle.textContent = title;

		pills.forEach((pill, i) => {
			if (i === currentStep) {
				pill.classList.remove(
					"bg-white",
					"text-black",
					"border-black/30",
				);
				pill.classList.add("bg-black", "text-white", "border-black");
			} else {
				pill.classList.add("bg-white", "text-black", "border-black/30");
				pill.classList.remove("bg-black", "text-white", "border-black");
			}
		});
	}

	function startAutoCarousel() {
		stopAutoCarousel();
		carouselInterval = setInterval(() => {
			showStep(currentStep + 1);
		}, 4200);
	}

	function stopAutoCarousel() {
		if (carouselInterval) {
			clearInterval(carouselInterval);
			carouselInterval = null;
		}
	}

	prevBtn?.addEventListener("click", () => {
		showStep(currentStep - 1);
		startAutoCarousel();
	});

	nextBtn?.addEventListener("click", () => {
		showStep(currentStep + 1);
		startAutoCarousel();
	});

	pills.forEach((pill, i) => {
		pill.addEventListener("click", () => {
			showStep(i);
			startAutoCarousel();
		});
	});

	// Pause auto rotation on mouse hover so user can read or click to zoom
	carouselContainer?.addEventListener("mouseenter", stopAutoCarousel);
	carouselContainer?.addEventListener("mouseleave", startAutoCarousel);

	// Start auto-advance initially
	startAutoCarousel();
</script>
