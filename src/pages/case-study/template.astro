---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

const projectMetadata = {
    title: "Case Study Template",
    role: "Lead Product Designer",
    timeline: "6 Months",
    team: "2 PMs, 4 Engineers",
    platform: "Web & Mobile",
};
---

<Layout title="Case Study Template - Tushar Roy">
    <main class="pt-32 pb-16">
        <!-- SECTION 1: HERO -->
        <header class="max-w-6xl mx-auto px-6 mb-24 md:mb-32">
            <div class="max-w-4xl">
                <span class="eyebrow-sm text-[var(--color-accent)] mb-4 block"
                    >Case Study Template</span
                >
                <h1 class="heading-display mb-8">
                    Designing for Clarity at Scale
                </h1>
                <p class="lead-text max-w-2xl">
                    A unified design system that transformed a fragmented
                    enterprise suite into a cohesive ecosystem, increasing user
                    adoption by 40%.
                </p>
            </div>
        </header>

        <!-- SECTION 2: HERO IMAGE (Full Bleed) -->
        <section class="max-w-7xl mx-auto px-6 mb-32">
            <div
                class="w-full aspect-[16/9] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl"
            >
                <!-- Replace with actual hero image -->
                <div
                    class="w-full h-full bg-[#EAEEF2] flex items-center justify-center text-[var(--color-text-secondary)]"
                >
                    [Hero Diagram / Interface Shot]
                </div>
            </div>
        </section>

        <!-- SECTION 3: OVERVIEW GRID -->
        <section class="max-w-6xl mx-auto px-6 mb-32">
            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-12 border-y border-[var(--color-text-primary)]/10 py-12"
            >
                <div class="metric-item">
                    <span class="metric-label">Role</span>
                    <span class="font-sans text-lg">{projectMetadata.role}</span
                    >
                </div>
                <div class="metric-item">
                    <span class="metric-label">Timeline</span>
                    <span class="font-sans text-lg"
                        >{projectMetadata.timeline}</span
                    >
                </div>
                <div class="metric-item">
                    <span class="metric-label">Team</span>
                    <span class="font-sans text-lg">{projectMetadata.team}</span
                    >
                </div>
                <div class="metric-item">
                    <span class="metric-label">Platform</span>
                    <span class="font-sans text-lg"
                        >{projectMetadata.platform}</span
                    >
                </div>
            </div>
        </section>

        <!-- SECTION 4: THE PROBLEM (Text Heavy + Side Note) -->
        <section class="max-w-6xl mx-auto px-6 mb-32">
            <div class="grid md:grid-cols-12 gap-12 items-start">
                <div class="md:col-span-8">
                    <h2 class="heading-medium mb-8">The Challenge</h2>
                    <p>
                        The legacy platform suffered from years of feature bloat
                        and inconsistent UI patterns. Users reported high
                        cognitive load and difficulty navigating between core
                        modules.
                    </p>
                    <p>
                        Our data showed that <strong
                            >65% of support tickets</strong
                        > were related to "finding information" rather than functionality
                        issues. We needed to simplify the architecture without removing
                        critical power-user features.
                    </p>
                </div>
                <div
                    class="md:col-span-4 bg-[#fcfaf8] p-8 rounded-xl border border-[#e0ba9b]/30"
                >
                    <span
                        class="eyebrow-sm text-[var(--color-accent)] mb-2 block"
                        >Key Constraint</span
                    >
                    <p class="text-base mb-0">
                        We could not rewrite the backend. All UX improvements
                        had to be strictly frontend implementation on existing
                        APIs.
                    </p>
                </div>
            </div>
        </section>

        <!-- SECTION 5: DISCOVERY & PERSONAS (Card Grid) -->
        <section class="bg-[#fcfaf8] py-24 mb-32">
            <div class="max-w-6xl mx-auto px-6">
                <h2 class="heading-medium text-center mb-16">
                    Understanding the User
                </h2>

                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Persona 1 -->
                    <div
                        class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="w-12 h-12 bg-[#F2EBE3] rounded-full mb-6 flex items-center justify-center text-lg"
                        >
                            👷
                        </div>
                        <h3 class="text-xl font-bold font-serif mb-2">
                            The Operator
                        </h3>
                        <p class="text-sm mb-4">
                            Focuses on efficiency and speed. Uses keyboard
                            shortcuts and memorized paths.
                        </p>
                        <ul
                            class="text-xs text-[var(--color-text-secondary)] space-y-2 list-disc pl-4"
                        >
                            <li>Needs densified data views</li>
                            <li>Frustrated by "wizard" flows</li>
                        </ul>
                    </div>

                    <!-- Persona 2 -->
                    <div
                        class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="w-12 h-12 bg-[#E8EFF5] rounded-full mb-6 flex items-center justify-center text-lg"
                        >
                            👔
                        </div>
                        <h3 class="text-xl font-bold font-serif mb-2">
                            The Manager
                        </h3>
                        <p class="text-sm mb-4">
                            Needs high-level overviews and reporting
                            capabilities to track team progress.
                        </p>
                        <ul
                            class="text-xs text-[var(--color-text-secondary)] space-y-2 list-disc pl-4"
                        >
                            <li>Needs dashboard summaries</li>
                            <li>Values clean visualizations</li>
                        </ul>
                    </div>

                    <!-- Persona 3 -->
                    <div
                        class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="w-12 h-12 bg-[#F1F3ED] rounded-full mb-6 flex items-center justify-center text-lg"
                        >
                            🏗️
                        </div>
                        <h3 class="text-xl font-bold font-serif mb-2">
                            The Admin
                        </h3>
                        <p class="text-sm mb-4">
                            Configures the system for others. Needs granular
                            control over permissions.
                        </p>
                        <ul
                            class="text-xs text-[var(--color-text-secondary)] space-y-2 list-disc pl-4"
                        >
                            <li>Needs bulk edit tools</li>
                            <li>Prioritizes system stability</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 6: PROCESS / SKETCHES (Alternating Layout) -->
        <section class="max-w-6xl mx-auto px-6 mb-32">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div class="order-2 md:order-1">
                    <div
                        class="aspect-square bg-gray-100 rounded-xl overflow-hidden shadow-inner flex items-center justify-center text-[var(--color-text-secondary)]"
                    >
                        [Low-Fi Wireframes Image]
                    </div>
                </div>
                <div class="order-1 md:order-2">
                    <span
                        class="eyebrow-sm text-[var(--color-accent)] mb-4 block"
                        >Iterative Design</span
                    >
                    <h3 class="heading-medium mb-6">Testing Assumptions</h3>
                    <p>
                        We started with rough paper prototypes to test the new
                        navigation ontology. Early testing revealed that users
                        struggled with the proposed "object-oriented" menu
                        structure.
                    </p>
                    <p>
                        We pivoted to a "task-based" architecture, which aligned
                        40% better with user mental models in subsequent A/B
                        testing.
                    </p>
                </div>
            </div>
        </section>

        <!-- SECTION 7: QUOTE BREAK -->
        <section class="max-w-4xl mx-auto px-6 mb-32 text-center">
            <blockquote
                class="border-none text-4xl md:text-5xl leading-tight not-italic font-serif pl-0 my-0"
            >
                "Simplifying the interface didn't mean hiding complexity, but
                organizing it intuitively."
            </blockquote>
        </section>

        <!-- SECTION 8: FINAL DESIGN (Feature Breakdown) -->
        <section class="max-w-6xl mx-auto px-6 mb-32 space-y-24">
            <!-- Feature 1 -->
            <article class="flex flex-col gap-8">
                <div
                    class="bg-[#EAEEF2] rounded-2xl aspect-[16/10] flex items-center justify-center shadow-lg"
                >
                    [High Fidelity Interface - Dashboard]
                </div>
                <div class="grid md:grid-cols-2 gap-8">
                    <h3 class="text-2xl font-serif">Unified Dashboard</h3>
                    <p class="text-base text-[var(--color-text-secondary)]">
                        A centralized view that surfaces critical alerts and
                        daily tasks, reducing the "morning hunt" for information
                        by estimated 15 minutes per user.
                    </p>
                </div>
            </article>

            <!-- Feature 2 -->
            <article class="flex flex-col gap-8">
                <div
                    class="bg-[#F2EBE3] rounded-2xl aspect-[16/10] flex items-center justify-center shadow-lg"
                >
                    [High Fidelity Interface - Mobile View]
                </div>
                <div class="grid md:grid-cols-2 gap-8">
                    <h3 class="text-2xl font-serif">Mobile-First Workflows</h3>
                    <p class="text-base text-[var(--color-text-secondary)]">
                        For the first time, field operators could complete
                        critical approvals on-site, removing the bottleneck of
                        returning to the office desktop.
                    </p>
                </div>
            </article>
        </section>

        <!-- SECTION 9: RESULTS -->
        <section class="bg-[var(--color-text-primary)] text-white py-24 mb-32">
            <div class="max-w-6xl mx-auto px-6">
                <div class="grid md:grid-cols-2 gap-16 items-center">
                    <div>
                        <span class="eyebrow-sm text-[#e0ba9b] mb-4 block"
                            >Outcomes</span
                        >
                        <h2
                            class="font-serif text-4xl md:text-5xl mb-8 text-white"
                        >
                            Measurable Impact
                        </h2>
                        <p class="text-white/70">
                            Post-launch analytics verified that the redesign
                            successfully aligned business goals with user needs.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 gap-8">
                        <div class="border-l border-white/20 pl-8">
                            <div
                                class="text-6xl font-serif font-bold text-[#e0ba9b] mb-2"
                            >
                                +40%
                            </div>
                            <div
                                class="font-sans text-sm tracking-widest uppercase opacity-80"
                            >
                                User Adoption
                            </div>
                        </div>
                        <div class="border-l border-white/20 pl-8">
                            <div
                                class="text-6xl font-serif font-bold text-[#e0ba9b] mb-2"
                            >
                                -25%
                            </div>
                            <div
                                class="font-sans text-sm tracking-widest uppercase opacity-80"
                            >
                                Support Volume
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 10: REFLECTION & NEXT -->
        <section class="max-w-4xl mx-auto px-6 mb-24">
            <h2 class="heading-medium mb-8">Reflections</h2>
            <div class="prose prose-lg text-[var(--color-text-secondary)]">
                <p>
                    This project reinforced the importance of involving
                    engineering early in the design process. The constraint of
                    "no backend changes" sparked creative UI solutions that
                    might not have emerged otherwise.
                </p>
                <p>
                    If I were to do this again, I would advocate for more robust
                    accessibility testing earlier in the definition phase.
                </p>
            </div>

            <div
                class="mt-24 pt-12 border-t border-black/10 flex justify-between items-center"
            >
                <a href="/#work" class="btn-link opacity-60 hover:opacity-100"
                    >← Back to All Work</a
                >
                <a href="#" class="btn-primary">
                    Next Case Study
                    <span class="btn-link-icon">→</span>
                </a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
