---
import Layout from "@theme/Layout.astro";
import Header from "@theme/Header.astro";
---

<Layout title="Design System • Tushar Roy">
  <Header backUrl="/" backLabel="Back to Home" breadcrumbs={["System", "Design System"]} />

  <style>
    body {
      background-color: #ffffff !important;
    }
    table td > * {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
  </style>

  <main class="max-w-6xl mx-auto px-6 sm:px-8 pt-32 sm:pt-36 md:pt-40 pb-28 text-black">
    <!-- Header -->
    <header class="border-b border-black pb-4 mb-12">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-black m-0">
        Design System
      </h1>
    </header>

    <!-- Colors -->
    <section id="colors" class="mb-16">
      <h2 class="font-heading text-xl font-bold text-black pb-3 mb-6 border-b border-black">
        Colors
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Color 1: canvas -->
        <div class="p-4 border border-black bg-white flex flex-col justify-between">
          <div>
            <div class="w-full h-20 border border-neutral-300 mb-3" style="background-color: #f8f6f0;"></div>
            <div class="font-mono text-xs font-bold text-black mb-1"><code>canvas</code></div>
            <div class="font-bold text-sm text-black mb-1">Warm Cream</div>
            <div class="font-mono text-xs text-neutral-500 mb-3">#f8f6f0</div>
          </div>
          <div class="pt-2 border-t border-neutral-200">
            <span class="font-mono text-[10px] uppercase font-bold text-neutral-400 block">Role</span>
            <span class="text-xs text-neutral-700">Primary Page Canvas</span>
          </div>
        </div>

        <!-- Color 2: surface -->
        <div class="p-4 border border-black bg-white flex flex-col justify-between">
          <div>
            <div class="w-full h-20 border border-neutral-300 mb-3" style="background-color: #ffffff;"></div>
            <div class="font-mono text-xs font-bold text-black mb-1"><code>surface</code></div>
            <div class="font-bold text-sm text-black mb-1">Pure White</div>
            <div class="font-mono text-xs text-neutral-500 mb-3">#ffffff</div>
          </div>
          <div class="pt-2 border-t border-neutral-200">
            <span class="font-mono text-[10px] uppercase font-bold text-neutral-400 block">Role</span>
            <span class="text-xs text-neutral-700">Cards & Raised Surfaces</span>
          </div>
        </div>

        <!-- Color 3: primary -->
        <div class="p-4 border border-black bg-white flex flex-col justify-between">
          <div>
            <div class="w-full h-20 border border-neutral-300 mb-3" style="background-color: #18181b;"></div>
            <div class="font-mono text-xs font-bold text-black mb-1"><code>primary</code></div>
            <div class="font-bold text-sm text-black mb-1">Deep Slate</div>
            <div class="font-mono text-xs text-neutral-500 mb-3">#18181b</div>
          </div>
          <div class="pt-2 border-t border-neutral-200">
            <span class="font-mono text-[10px] uppercase font-bold text-neutral-400 block">Role</span>
            <span class="text-xs text-neutral-700">Display Headings & Text</span>
          </div>
        </div>

        <!-- Color 4: secondary -->
        <div class="p-4 border border-black bg-white flex flex-col justify-between">
          <div>
            <div class="w-full h-20 border border-neutral-300 mb-3" style="background-color: #52525b;"></div>
            <div class="font-mono text-xs font-bold text-black mb-1"><code>secondary</code></div>
            <div class="font-bold text-sm text-black mb-1">Muted Slate</div>
            <div class="font-mono text-xs text-neutral-500 mb-3">#52525b</div>
          </div>
          <div class="pt-2 border-t border-neutral-200">
            <span class="font-mono text-[10px] uppercase font-bold text-neutral-400 block">Role</span>
            <span class="text-xs text-neutral-700">Body Prose & Meta Copy</span>
          </div>
        </div>

        <!-- Color 5: accent -->
        <div class="p-4 border border-black bg-white flex flex-col justify-between">
          <div>
            <div class="w-full h-20 border border-neutral-300 mb-3" style="background-color: #f6c867;"></div>
            <div class="font-mono text-xs font-bold text-black mb-1"><code>accent</code></div>
            <div class="font-bold text-sm text-black mb-1">Saffron Amber</div>
            <div class="font-mono text-xs text-neutral-500 mb-3">#f6c867 / #c98c1c</div>
          </div>
          <div class="pt-2 border-t border-neutral-200">
            <span class="font-mono text-[10px] uppercase font-bold text-neutral-400 block">Role</span>
            <span class="text-xs text-neutral-700">Actions, Highlights, Kickers</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tags -->
    <section id="tags">
      <h2 class="font-heading text-xl font-bold text-black pb-3 mb-6 border-b border-black">
        Tags
      </h2>

      <div class="overflow-x-auto border border-black bg-white">
        <table class="w-full text-left font-sans text-xs sm:text-sm m-0 border-collapse">
          <thead class="bg-neutral-100 border-b border-black font-mono text-xs text-black uppercase tracking-wider">
            <tr>
              <th class="p-4">Element / Tag</th>
              <th class="p-4">Font Family</th>
              <th class="p-4">Size & Leading</th>
              <th class="p-4">Weight</th>
              <th class="p-4">Color</th>
              <th class="p-4 min-w-[280px]">Example</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 text-xs">
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;h1&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">48-72px / 1.04</td>
              <td class="p-4 font-mono text-neutral-600">Bold (700)</td>
              <td class="p-4 font-mono text-neutral-800"><code>primary</code></td>
              <td class="p-4">
                <h1>Systematic by Design.</h1>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;h2&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">30-48px / tight</td>
              <td class="p-4 font-mono text-neutral-600">Bold (700)</td>
              <td class="p-4 font-mono text-neutral-800"><code>primary</code></td>
              <td class="p-4">
                <h2>Selected Works</h2>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;h3&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">24-36px / tight</td>
              <td class="p-4 font-mono text-neutral-600">Bold (700)</td>
              <td class="p-4 font-mono text-neutral-800"><code>primary</code></td>
              <td class="p-4">
                <h3>Making Security Work Measurable</h3>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;h4&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">18-20px / 1.2</td>
              <td class="p-4 font-mono text-neutral-600">Bold (700)</td>
              <td class="p-4 font-mono text-neutral-800"><code>primary</code></td>
              <td class="p-4">
                <h4>30% → 75%</h4>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>.eyebrow</code></td>
              <td class="p-4 font-mono text-neutral-600">Space Mono</td>
              <td class="p-4 font-mono text-neutral-600">12px / uppercase</td>
              <td class="p-4 font-mono text-neutral-600">Medium (500)</td>
              <td class="p-4 font-mono text-neutral-800"><code>secondary</code></td>
              <td class="p-4">
                <small class="eyebrow">PRODUCT UX // DESIGN SYSTEMS ARCHITECT</small>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>.kicker</code></td>
              <td class="p-4 font-mono text-neutral-600">Homemade Apple</td>
              <td class="p-4 font-mono text-neutral-600">16-18px / normal</td>
              <td class="p-4 font-mono text-neutral-600">Regular (400)</td>
              <td class="p-4 font-mono text-neutral-800"><code>accent</code></td>
              <td class="p-4">
                <small class="kicker">context</small>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;figcaption&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">Space Mono</td>
              <td class="p-4 font-mono text-neutral-600">12-13px / tracking</td>
              <td class="p-4 font-mono text-neutral-600">Regular (400)</td>
              <td class="p-4 font-mono text-neutral-800"><code>secondary</code></td>
              <td class="p-4">
                <figcaption>Central executive dashboard displaying...</figcaption>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;p&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">16-18px / 1.6</td>
              <td class="p-4 font-mono text-neutral-600">Regular (400)</td>
              <td class="p-4 font-mono text-neutral-800"><code>secondary</code></td>
              <td class="p-4">
                <p>Enterprise software doesn't have to feel like bureaucratic punishment.</p>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;button&gt; .primary</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">14-16px / pill</td>
              <td class="p-4 font-mono text-neutral-600">Medium (500)</td>
              <td class="p-4 font-mono text-neutral-800"><code>accent</code></td>
              <td class="p-4">
                <button class="primary group">
                  <span>See what I built</span>
                  <span class="w-5 h-5 rounded-full bg-neutral-900 text-white inline-flex items-center justify-center text-xs leading-none">↓</span>
                </button>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;button&gt; .secondary</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">14-16px / pill</td>
              <td class="p-4 font-mono text-neutral-600">Medium (500)</td>
              <td class="p-4 font-mono text-neutral-800"><code>surface</code></td>
              <td class="p-4">
                <button class="secondary">
                  <span>Connect on LinkedIn</span>
                  <span>↗</span>
                </button>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>&lt;blockquote&gt;</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans Italic</td>
              <td class="p-4 font-mono text-neutral-600">18-24px / 1.5</td>
              <td class="p-4 font-mono text-neutral-600">Regular (400)</td>
              <td class="p-4 font-mono text-neutral-800"><code>primary</code></td>
              <td class="p-4">
                <blockquote>"Tushar brings people together"</blockquote>
              </td>
            </tr>
            <tr class="hover:bg-neutral-50">
              <td class="p-4 font-mono font-bold text-black"><code>.card</code></td>
              <td class="p-4 font-mono text-neutral-600">DM Sans</td>
              <td class="p-4 font-mono text-neutral-600">14-16px / rounded-2xl</td>
              <td class="p-4 font-mono text-neutral-600">—</td>
              <td class="p-4 font-mono text-neutral-800"><code>surface</code></td>
              <td class="p-4">
                <div class="card">
                  <h4>Unified Metric Lineage</h4>
                  <p>Consolidating multi-region telemetry into a single verified pane of glass.</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>
