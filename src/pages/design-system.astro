---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Design System Reference • Developer Spec">
	<div class="min-h-screen bg-[#faf8f2] text-[#1a1918] antialiased selection:bg-black selection:text-white font-space">
		
		<!-- Minimal Header -->
		<header class="sticky top-0 z-40 bg-[#faf8f2]/95 backdrop-blur-md border-b border-black/15 py-3 px-6">
			<div class="max-w-7xl mx-auto flex items-center justify-between font-departure text-xs">
				<a href="/" class="flex items-center gap-2 text-black hover:text-neutral-600 transition-colors no-underline">
					<span>←</span>
					<span>Portfolio</span>
				</a>
				<div class="flex items-center gap-2 font-bold">
					<span class="px-2 py-0.5 bg-black text-white text-[10px]">PRIVATE</span>
					<span>Internal Design System & HTML Tag Reference</span>
				</div>
				<a
					href="/case-study/vanguard"
					class="text-black/70 hover:text-black transition-colors no-underline text-[11px]"
				>
					Vanguard Live →
				</a>
			</div>
		</header>

		<!-- Main 2-Column Layout -->
		<main class="max-w-7xl mx-auto px-6 sm:px-8 py-10 md:py-14">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
				
				<!-- ========================================================= -->
				<!-- LEFT COLUMN (25%): STICKY NAVIGATION RAIL                -->
				<!-- ========================================================= -->
				<nav class="md:col-span-3 md:sticky md:top-16 self-start h-[calc(100vh-4.5rem)] overflow-y-auto pr-4 space-y-6 text-xs font-departure border-0 border-r border-black/15 shadow-none bg-transparent p-0 m-0">
					
					<!-- Foundations Nav -->
					<div>
						<span class="text-black/40 block font-bold tracking-wider mb-2">FOUNDATIONS</span>
						<div class="space-y-1">
							<a href="#a11y" class="block py-1 px-2 text-black/80 hover:bg-black/5 hover:text-black rounded-xs no-underline">Accessibility</a>
							<a href="#colors" class="block py-1 px-2 text-black/80 hover:bg-black/5 hover:text-black rounded-xs no-underline">Colors</a>
							<a href="#grids" class="block py-1 px-2 text-black/80 hover:bg-black/5 hover:text-black rounded-xs no-underline">Grids &amp; Layout</a>
							<a href="#icons" class="block py-1 px-2 text-black/80 hover:bg-black/5 hover:text-black rounded-xs no-underline">Icons &amp; Badges</a>
							<a href="#spacing" class="block py-1 px-2 text-black/80 hover:bg-black/5 hover:text-black rounded-xs no-underline">Spacing</a>
							<a href="#typography" class="block py-1 px-2 text-black/80 hover:bg-black/5 hover:text-black rounded-xs no-underline">Typography</a>
						</div>
					</div>

					<!-- Elements & Components Nav (Numbered) -->
					<div>
						<span class="text-black/40 block font-bold tracking-wider mb-2">HTML TAGS &amp; COMPONENTS</span>
						<div class="space-y-0.5 text-[11px]">
							<a href="#item-01" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">01.</span> &lt;article&gt;</a>
							<a href="#item-02" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">02.</span> &lt;h1&gt;</a>
							<a href="#item-03" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">03.</span> &lt;h2&gt;</a>
							<a href="#item-04" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">04.</span> &lt;h3&gt;</a>
							<a href="#item-05" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">05.</span> &lt;h4&gt;</a>
							<a href="#item-06" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">06.</span> &lt;p&gt;</a>
							<a href="#item-07" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">07.</span> &lt;em&gt; &amp; &lt;i&gt;</a>
							<a href="#item-08" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">08.</span> &lt;strong&gt; &amp; &lt;b&gt;</a>
							<a href="#item-09" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">09.</span> &lt;blockquote&gt; + &lt;cite&gt;</a>
							<a href="#item-10" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">10.</span> &lt;aside&gt;</a>
							<a href="#item-11" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">11.</span> &lt;figure&gt; + &lt;figcaption&gt;</a>
							<a href="#item-12" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">12.</span> &lt;table&gt; (Data Matrix)</a>
							<a href="#item-13" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">13.</span> &lt;ul&gt;</a>
							<a href="#item-14" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">14.</span> &lt;ol&gt;</a>
							<a href="#item-15" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">15.</span> &lt;code&gt;</a>
							<a href="#item-16" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">16.</span> &lt;kbd&gt;</a>
							<a href="#item-17" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">17.</span> &lt;mark&gt;</a>
							<a href="#item-18" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">18.</span> &lt;time&gt;</a>
							<a href="#item-19" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">19.</span> &lt;hr&gt;</a>
							<a href="#item-21" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">21.</span> .card</a>
							<a href="#item-22" class="block py-0.5 px-2 text-black/70 hover:bg-black/5 hover:text-black no-underline"><span class="font-mono text-black/40">22.</span> #image-lightbox</a>
						</div>
					</div>

					<div class="pt-4 border-t border-black/10 text-[10px] text-black/50">
						Built with semantic HTML5 &amp; global.css. No inline Tailwind utility chains.
					</div>
				</nav>

				<!-- ========================================================= -->
				<!-- RIGHT COLUMN (75%): FOUNDATIONS & NUMBERED SPECIMENS      -->
				<!-- ========================================================= -->
				<div class="md:col-span-9 space-y-16">
					
					<!-- Header Intro -->
					<div class="border-b border-black/15 pb-6">
						<span class="kicker">reference</span>
						<h1 class="text-3xl sm:text-4xl font-departure font-bold text-black mb-2">
							Site Design System &amp; Elements
						</h1>
						<p class="font-sans text-base text-black/70 max-w-2xl m-0">
							Private design guide mapping visual patterns directly to semantic HTML elements and global CSS tokens.
						</p>
					</div>

					<!-- ===================================================== -->
					<!-- FOUNDATIONS 1: ACCESSIBILITY                          -->
					<!-- ===================================================== -->
					<section id="a11y" class="border-b border-black/15 pb-12">
						<span class="kicker">foundations</span>
						<h2 class="text-2xl font-bold font-departure text-black mb-4">Accessibility (A11y) Standards</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-sans">
							<div class="border border-black/15 p-4 bg-white">
								<strong class="font-departure block mb-1 font-bold text-black">1. Contrast Ratio ≥ 12:1</strong>
								<p class="m-0 text-black/75">Body text uses #1a1918 (or black/85) on #faf8f2, achieving 13.8:1 contrast (exceeds WCAG AAA requirement of 7:1).</p>
							</div>
							<div class="border border-black/15 p-4 bg-white">
								<strong class="font-departure block mb-1 font-bold text-black">2. Strict Heading Hierarchy</strong>
								<p class="m-0 text-black/75">Exactly one &lt;h1&gt; per page. Major sections use &lt;h2&gt;. Sub-items use &lt;h3&gt; and &lt;h4&gt;. No levels skipped.</p>
							</div>
							<div class="border border-black/15 p-4 bg-white">
								<strong class="font-departure block mb-1 font-bold text-black">3. Zero Forced Uppercase</strong>
								<p class="m-0 text-black/75">Never apply CSS <code>text-transform: uppercase</code>. Screen readers and users read natural sentence casing cleanly.</p>
							</div>
							<div class="border border-black/15 p-4 bg-white">
								<strong class="font-departure block mb-1 font-bold text-black">4. Keyboard &amp; Zoom Access</strong>
								<p class="m-0 text-black/75">All interactive modals support <kbd>ESC</kbd> to close. Interactive elements have focus outlines.</p>
							</div>
						</div>
					</section>

					<!-- ===================================================== -->
					<!-- FOUNDATIONS 2: COLORS                                 -->
					<!-- ===================================================== -->
					<section id="colors" class="border-b border-black/15 pb-12">
						<span class="kicker">foundations</span>
						<h2 class="text-2xl font-bold font-departure text-black mb-4">Color Palette &amp; Tokens</h2>
						<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs font-departure">
							<div class="border border-black/15 p-3 bg-white">
								<div class="h-10 border border-black/10 bg-[#faf8f2] mb-2"></div>
								<strong class="block text-black">Background Warm</strong>
								<span class="text-black/60 font-mono text-[10px]">#faf8f2</span>
								<span class="block text-[10px] text-black/40 mt-1">Page Canvas</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<div class="h-10 border border-black/10 bg-[#1a1918] mb-2"></div>
								<strong class="block text-black">Text Primary</strong>
								<span class="text-black/60 font-mono text-[10px]">#1a1918</span>
								<span class="block text-[10px] text-black/40 mt-1">Headings &amp; Deep Prose</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<div class="h-10 border border-black/10 bg-black/75 mb-2"></div>
								<strong class="block text-black">Text Secondary</strong>
								<span class="text-black/60 font-mono text-[10px]">rgba(0,0,0,0.75)</span>
								<span class="block text-[10px] text-black/40 mt-1">Body Text &amp; Subheads</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<div class="h-10 border border-black/10 bg-black/15 mb-2"></div>
								<strong class="block text-black">Border Rule</strong>
								<span class="text-black/60 font-mono text-[10px]">rgba(0,0,0,0.15)</span>
								<span class="block text-[10px] text-black/40 mt-1">Section Dividers</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<div class="h-10 border border-dashed border-black/25 bg-black/[0.02] mb-2"></div>
								<strong class="block text-black">Dashed Border</strong>
								<span class="text-black/60 font-mono text-[10px]">rgba(0,0,0,0.25)</span>
								<span class="block text-[10px] text-black/40 mt-1">Image &amp; Media Containers</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<div class="h-10 border border-black/10 bg-amber-100 mb-2"></div>
								<strong class="block text-black">Accent Highlight</strong>
								<span class="text-black/60 font-mono text-[10px]">#fef3c7 (amber-100)</span>
								<span class="block text-[10px] text-black/40 mt-1">&lt;mark&gt; High-impact Metrics</span>
							</div>
						</div>
					</section>

					<!-- ===================================================== -->
					<!-- FOUNDATIONS 3: GRIDS & LAYOUT                         -->
					<!-- ===================================================== -->
					<section id="grids" class="border-b border-black/15 pb-12">
						<span class="kicker">foundations</span>
						<h2 class="text-2xl font-bold font-departure text-black mb-4">Grids &amp; Layout Framework</h2>
						<div class="space-y-4 text-xs font-sans">
							<div class="border border-black/15 p-4 bg-white">
								<div class="flex items-center justify-between font-departure font-bold text-xs mb-2">
									<span>Two-Column Editorial Split (25% / 75%)</span>
									<code>.case-grid = grid md:grid-cols-12</code>
								</div>
								<div class="grid grid-cols-12 gap-2 text-center font-departure text-[11px] py-3 bg-[#faf8f2] border border-black/10">
									<div class="col-span-3 bg-black/10 p-3 border border-black/20">
										<strong>25% Left Rail</strong><br/>
										<span class="text-black/60">Sticky kicker + H2</span>
									</div>
									<div class="col-span-9 bg-black/5 p-3 border border-black/15">
										<strong>75% Right Content</strong><br/>
										<span class="text-black/60">Prose, Figures, Callouts, Data Tables</span>
									</div>
								</div>
							</div>

							<div class="border border-black/15 p-4 bg-white">
								<div class="flex items-center justify-between font-departure font-bold text-xs mb-2">
									<span>Three-Column Scorecard Grid</span>
									<code>grid grid-cols-1 sm:grid-cols-3 gap-6</code>
								</div>
								<div class="grid grid-cols-3 gap-2 text-center font-departure text-[11px] py-2 bg-[#faf8f2] border border-black/10">
									<div class="bg-white p-2 border border-black/20">Col 1: Role / Metric</div>
									<div class="bg-white p-2 border border-black/20">Col 2: Timeline / Impact</div>
									<div class="bg-white p-2 border border-black/20">Col 3: Org / Results</div>
								</div>
							</div>
						</div>
					</section>

					<!-- ===================================================== -->
					<!-- FOUNDATIONS 4: ICONS & BADGES                         -->
					<!-- ===================================================== -->
					<section id="icons" class="border-b border-black/15 pb-12">
						<span class="kicker">foundations</span>
						<h2 class="text-2xl font-bold font-departure text-black mb-4">Icons, Tokens &amp; Badges</h2>
						<div class="flex flex-wrap gap-4 items-center p-4 bg-white border border-black/15">
							<span class="font-departure text-[11px] tracking-wider px-2 py-0.5 bg-black/5 text-black/70 border border-black/10">
								Vanguard
							</span>
							<span class="font-departure text-[10px] bg-black text-white px-2 py-0.5">
								BI Led
							</span>
							<span class="font-departure text-[10px] bg-neutral-200 text-black px-2 py-0.5 border border-black/20">
								99.9% SLA
							</span>
							<kbd>ESC</kbd>
							<span class="font-departure text-xs font-bold">← Previous</span>
							<span class="font-departure text-xs font-bold">Next →</span>
						</div>
					</section>

					<!-- ===================================================== -->
					<!-- FOUNDATIONS 5: SPACING                                -->
					<!-- ===================================================== -->
					<section id="spacing" class="border-b border-black/15 pb-12">
						<span class="kicker">foundations</span>
						<h2 class="text-2xl font-bold font-departure text-black mb-4">Spacing Scale</h2>
						<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-departure">
							<div class="border border-black/15 p-3 bg-white">
								<strong class="block text-black">Section Divider</strong>
								<span class="font-mono text-black/60">mb-20 md:mb-28</span>
								<span class="block text-[10px] text-black/40 mt-1">80px – 112px bottom</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<strong class="block text-black">Grid Gutter</strong>
								<span class="font-mono text-black/60">gap-8 md:gap-12</span>
								<span class="block text-[10px] text-black/40 mt-1">32px – 48px horizontal</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<strong class="block text-black">Card Padding</strong>
								<span class="font-mono text-black/60">p-5 sm:p-6</span>
								<span class="block text-[10px] text-black/40 mt-1">20px – 24px inner</span>
							</div>
							<div class="border border-black/15 p-3 bg-white">
								<strong class="block text-black">Reading Measure</strong>
								<span class="font-mono text-black/60">max-w-[65ch]</span>
								<span class="block text-[10px] text-black/40 mt-1">Optimal prose line length</span>
							</div>
						</div>
					</section>

					<!-- ===================================================== -->
					<!-- FOUNDATIONS 6: TYPOGRAPHY                             -->
					<!-- ===================================================== -->
					<section id="typography" class="border-b border-black/15 pb-12">
						<span class="kicker">foundations</span>
						<h2 class="text-2xl font-bold font-departure text-black mb-4">Typography &amp; Fonts</h2>
						<div class="space-y-4 font-sans text-xs">
							<div class="border border-black/15 p-4 bg-white">
								<span class="font-departure text-[11px] text-black/50 block mb-1">01. Monospace Headings &amp; UI</span>
								<strong class="text-base font-departure text-black block mb-1">Departure Mono / Space Mono</strong>
								<p class="m-0 text-black/75">Used for all headings (&lt;h1&gt;–&lt;h4&gt;), metadata badges, code, tables, and UI controls.</p>
							</div>
							<div class="border border-black/15 p-4 bg-white">
								<span class="font-departure text-[11px] text-black/50 block mb-1">02. Editorial Handwritten Script</span>
								<strong class="text-base font-homemade text-black block mb-1">Homemade Apple</strong>
								<p class="m-0 text-black/75">Used for section category kickers and inline editorial emphasis (&lt;em&gt;, &lt;i&gt;).</p>
							</div>
							<div class="border border-black/15 p-4 bg-white">
								<span class="font-departure text-[11px] text-black/50 block mb-1">03. Body Prose</span>
								<strong class="text-base font-sans text-black block mb-1">DM Sans / System Sans</strong>
								<p class="m-0 text-black/75">Used for comfortable, high-legibility case study body paragraphs at 18px with relaxed line-height.</p>
							</div>
						</div>
					</section>

					<!-- ===================================================== -->
					<!-- NUMBERED HTML TAGS & COMPONENTS CATALOG               -->
					<!-- ===================================================== -->
					<div class="pt-4">
						<span class="kicker">catalog</span>
						<h2 class="text-2xl sm:text-3xl font-bold font-departure text-black mb-2">
							Numbered Elements &amp; Components
						</h2>
						<p class="font-sans text-sm text-black/70 mb-8">
							Live rendered specimens, exact usage locations in the codebase, and clean semantic syntax.
						</p>

						<div class="space-y-12">
							
							<!-- ITEM 01: <article> -->
							<div id="item-01" class="border-2 border-black bg-white p-6 shadow-[3px_3px_0_0_#000]">
								<div class="flex flex-wrap items-center justify-between pb-3 mb-4 border-b border-black/15 gap-2 font-departure text-xs">
									<div class="flex items-center gap-2">
										<span class="px-2 py-0.5 bg-black text-white font-bold">01</span>
										<strong class="text-black text-sm">&lt;article&gt;</strong>
									</div>
									<span class="px-2 py-0.5 bg-black/5 text-black/70 border border-black/10">Used in: vanguard.astro (all section roots)</span>
								</div>
								<div class="p-4 bg-[#faf8f2] border border-black/10 mb-4">
									<article class="case-section m-0 pb-4 border-b border-black/15">
										<p class="m-0 text-xs font-departure text-black/60">Semantic container demarcating an independent major chapter/section of the case study.</p>
									</article>
								</div>
								<pre class="bg-neutral-900 text-neutral-100 p-3 text-xs font-mono overflow-x-auto rounded-xs m-0"><code>&lt;article class="case-section"&gt;
  &lt;!-- Left rail + right content --&gt;
&lt;/article&gt;</code></pre>
							</div>

							<!-- ITEM 02: <h1> -->
							<div id="item-02" class="border-2 border-black bg-white p-6 shadow-[3px_3px_0_0_#000]">
								<div class="flex flex-wrap items-center justify-between pb-3 mb-4 border-b border-black/15 gap-2 font-departure text-xs">
									<div class="flex items-center gap-2">
										<span class="px-2 py-0.5 bg-black text-white font-bold">02</span>
										<strong class="text-black text-sm">&lt;h1&gt;</strong>
									</div>
									<span class="px-2 py-0.5 bg-black/5 text-black/70 border border-black/10">Used in: vanguard.astro:L60</span>
								</div>
								<div class="p-4 bg-[#faf8f2] border border-black/10 mb-4">
									<h1 class="m-0 text-2xl sm:text-3xl md:text-4xl font-normal leading-tight font-departure">
										Vanguard 3.1: Self-Service Business Intelligence
									</h1>
								</div>
								<pre class="bg-neutral-900 text-neutral-100 p-3 text-xs font-mono overflow-x-auto rounded-xs m-0"><code>&lt;h1&gt;Vanguard 3.1: Self-Service Business Intelligence&lt;/h1&gt;</code></pre>
							</div>

							<!-- ITEM 03: <h2> -->
							<div id="item-03" class="border-2 border-black bg-white p-6 shadow-[3px_3px_0_0_#000]">
								<div class="flex flex-wrap items-center justify-between pb-3 mb-4 border-b border-black/15 gap-2 font-departure text-xs">
									<div class="flex items-center gap-2">
										<span class="px-2 py-0.5 bg-black text-white font-bold">03</span>
										<strong class="text-black text-sm">&lt;h2&gt;</strong>
